# Public Outlook published calendar (.ics) — safe to expose; used for subscribe + site calendar
PUBLIC_CALENDAR_ICS_URL=
CALENDAR_ICS_URL=

# Microsoft 365 calendar scripts (scripts/calendar.mjs, run locally; never set on Vercel).
# Entra app "RNC Calendar Manager", scoped to the admin@ mailbox via Exchange RBAC for Applications.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Supabase — names match the Vercel Supabase integration.
# Use these three for the app. Ignore POSTGRES_* and SUPABASE_JWT_SECRET.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# PostGrid — address autocomplete + future print mailouts (server only)
POSTGRID_API_KEY=

# Planning Center syncs (see docs/sync.md). Production only on Vercel.
PLANNING_CENTER_PAT=
PLANNING_CENTER_PAT_SECRET=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
POSTGRID_PRINT_MAIL_API_KEY=
# Vercel sends this as the Authorization bearer token to /api/cron/*
CRON_SECRET=
# Alert emails via Postmark (optional until set up)
POSTMARK_SERVER_TOKEN=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Optional dead-man's-switch pings
HEALTHCHECK_URL_MAILCHIMP_SYNC=
HEALTHCHECK_URL_POSTGRID_SYNC=


# Mailing list signup (double opt-in). Production only on Vercel; other environments use Turnstile test keys
# and log the confirmation link instead of sending it (set SIGNUP_LIVE=1 locally to really send and write).
# TURNSTILE_KEYS is "sitekey,secret" from the Cloudflare widget for this site.
TURNSTILE_KEYS=
POSTMARK_TOKEN=
SIGNUP_SECRET=
