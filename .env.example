PUBLIC_CALENDAR_ICS_URL=
CALENDAR_ICS_URL=

# Supabase — names match the Vercel Supabase integration.
# Use these three for the app. Ignore POSTGRES_* and SUPABASE_JWT_SECRET.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
