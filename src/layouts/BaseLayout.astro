---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  noindex?: boolean;
  /** Load Google Analytics even on a noindex page (the signup-confirmed page counts as a conversion). */
  analytics?: boolean;
  /** Path or absolute URL of the social share image. */
  image?: string;
}

const {
  title = 'Roseville New Church',
  description = 'A Swedenborgian community in Sydney — worshipping the Lord Jesus Christ and exploring His love and wisdom together.',
  currentPath = '/',
  noindex = false,
  analytics,
  image = '/images/church/exterior.jpg',
} = Astro.props;

const pageTitle =
  title === 'Roseville New Church'
    ? title
    : `${title} · Roseville New Church`;

// Canonical URL on the www host, with a trailing slash to match the sitemap.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// Vercel preview deployments (a branch shared for review) are not the live site: sign-in codes aren't emailed and the forms
// don't send there, so say so at the top of every page.
const isPreview = process.env.VERCEL_ENV === 'preview';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    {(analytics ?? !noindex) && <Analytics />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Roseville New Church" />
          <meta property="og:locale" content="en_AU" />
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={imageUrl} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={pageTitle} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={imageUrl} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    {
      isPreview && (
        <div class="bg-violet-100 border-b border-violet-200 px-4 py-2 text-center text-[13px] text-violet-900" role="note">
          <strong>Preview for review.</strong> This isn’t the live website: sign-in codes aren’t emailed and the forms don’t send here.
        </div>
      )
    }
    <Header currentPath={currentPath} />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
