---
import '../styles/global.css';

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  currentPath: string;
  email: string;
  description?: string;
}

const {
  title,
  currentPath,
  email,
  description = 'Roseville New Church admin',
} = Astro.props;

const pageTitle = `${title} · Admin · Roseville New Church`;

const nav: NavItem[] = [
  { href: '/admin/sunday-theme', label: 'Sunday theme' },
  { href: '/admin/membership', label: 'Membership' },
  { href: '/admin/actions', label: 'Actions' },
  { href: '/admin/users', label: 'Users' },
  { href: '/admin/account', label: 'Account' },
  { href: '/account/details', label: 'My member account' },
];

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <div class="flex min-h-screen">
      <aside
        class="flex w-56 shrink-0 flex-col border-r border-border-soft bg-violet-950 text-text-on-dark"
      >
        <div class="flex items-center gap-3 border-b border-white/10 px-4 py-4">
          <img
            src="/brand/rnc-icon-colour.svg"
            alt=""
            class="size-9 shrink-0 rounded-full bg-white/10 p-1.5"
            width="36"
            height="36"
          />
          <div class="min-w-0 flex flex-col justify-center leading-none gap-1">
            <p class="font-display text-[13px] font-semibold tracking-[0.04em] text-white truncate">
              RNC Admin
            </p>
            <a
              href="/"
              class="font-display text-[11px] font-semibold tracking-[0.03em] text-violet-200 no-underline hover:text-white"
            >
              View site
            </a>
          </div>
        </div>

        <nav class="flex flex-1 flex-col gap-0.5 p-3" aria-label="Admin">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'font-display text-sm font-semibold tracking-wide rounded-md px-3 py-2.5 no-underline transition-colors',
                  isActive(item.href)
                    ? 'bg-white/15 text-white'
                    : 'text-violet-100 hover:bg-white/10 hover:text-white',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="border-t border-white/10 p-3 space-y-2">
          <p class="px-3 text-xs text-violet-200 truncate" title={email}>
            {email}
          </p>
          <form method="POST" action="/api/auth/logout">
            <button
              type="submit"
              class="w-full rounded-md px-3 py-2 text-left font-display text-sm font-semibold text-violet-100 hover:bg-white/10 hover:text-white"
            >
              Log out
            </button>
          </form>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header
          class="flex items-center border-b border-border-soft bg-white/80 px-6 py-4 backdrop-blur"
        >
          <h1 class="font-display text-xl font-semibold text-text-heading tracking-wide">
            {title}
          </h1>
        </header>
        <main class="flex-1 overflow-auto p-6 md:p-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
