---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="About"
  description="An old faith, seen in new light — about Roseville New Church, a Swedenborgian community in Sydney."
  currentPath="/about"
>
  <main class="container-prose px-6 md:px-8 pt-10 md:pt-14">
    <div
      class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5"
    >
      ✦ About us
    </div>
    <h1 class="mt-0 text-h1">An old faith, seen in new light</h1>
    <p class="text-lg">
      The Roseville New Church is a place of worship for those seeking to
      understand the Bible and the nature of God through the theological writings
      of Emanuel Swedenborg.
    </p>
    <p>
      We worship the Lord Jesus Christ as the one true God, in heaven and on
      earth. Our aim is to deepen our understanding of His love and wisdom, and
      to help one another lead joyful and useful lives — in the present and the
      hereafter.
    </p>
    <p
      class="italic text-[22px] leading-[1.5] text-violet-700 my-9 text-center"
    >
      “Love in its essence is spiritual fire.”
    </p>
    <p>
      You don't need to know anything about Swedenborg to visit. Come as you
      are, ask anything, and stay for morning tea.
    </p>

    <div id="visit" class="scroll-mt-24 mt-8">
      <Card variant="tint" title="Come and see us">
        Sundays at 10am · 4 Shirley Rd, Roseville NSW 2069 — two minutes' walk
        from Roseville station.
        <Button
          slot="footer"
          href="https://maps.google.com/?q=4+Shirley+Rd,+Roseville+NSW+2069"
        >
          Get directions
        </Button>
      </Card>
    </div>
  </main>
</BaseLayout>
