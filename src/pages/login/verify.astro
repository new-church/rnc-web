---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Input from '../../components/Input.astro';
import { createSupabaseServerClient } from '../../lib/auth/supabase';
import { ensureAppUserAfterLogin } from '../../lib/auth/users';
import { userHasAdminAccess } from '../../lib/auth/users';

const emailParam = Astro.url.searchParams.get('email')?.trim() ?? '';
let error = '';
let email = emailParam;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? emailParam).trim();
  const token = String(form.get('token') ?? '').trim();

  if (!email || !token) {
    error = 'Email and code are required.';
  } else {
    try {
      const supabase = createSupabaseServerClient({
        request: Astro.request,
        cookies: Astro.cookies,
      });
      const { data, error: verifyError } = await supabase.auth.verifyOtp({
        email,
        token,
        type: 'email',
      });

      if (verifyError || !data.user?.id || !data.user.email) {
        error = verifyError?.message ?? 'Could not verify that code.';
      } else {
        const appUser = await ensureAppUserAfterLogin({
          email: data.user.email,
          authUserId: data.user.id,
          displayName:
            (data.user.user_metadata?.full_name as string | undefined) ?? null,
        });

        if (userHasAdminAccess(appUser)) {
          return Astro.redirect('/admin/users');
        }
        return Astro.redirect('/login?error=forbidden');
      }
    } catch (err) {
      error = err instanceof Error ? err.message : String(err);
    }
  }
}
---

<BaseLayout
  title="Check your email"
  description="Open the sign-in link, or enter a code if your email includes one."
  currentPath="/login"
>
  <main class="container-site px-4 sm:px-6 md:px-8 py-10 md:py-14 max-w-md">
    <h1 class="font-display text-3xl text-ink mb-2">Check your email</h1>
    <p class="text-ink-muted mb-8 leading-relaxed">
      {
        email
          ? `We sent a message to ${email}. Click the link in that email to finish signing in (check spam).`
          : 'Open the link from your email to finish signing in.'
      }
      {' '}
      If the email also includes a numeric code, you can enter it below.
    </p>

    {
      error && (
        <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-900 text-sm">
          {error}
        </p>
      )
    }

    <form method="POST" class="flex flex-col gap-4">
      <Input
        label="Email"
        id="email"
        name="email"
        type="email"
        required
        value={email}
      />
      <Input
        label="Code (optional path)"
        id="token"
        name="token"
        type="text"
        required
        placeholder="123456"
        autocomplete="one-time-code"
      />
      <Button type="submit" variant="secondary">Verify code</Button>
      <p class="text-sm text-ink-muted">
        <a href="/login" class="text-accent-primary-strong underline">Use a different email</a>
      </p>
    </form>
  </main>
</BaseLayout>
