---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Input from '../../components/Input.astro';
import { getSessionContext } from '../../lib/auth/session';
import { turnstileKeys } from '../../lib/signup';
import { memberContext } from '../../lib/members/guard';

if (await getSessionContext({ cookies: Astro.cookies })) return Astro.redirect('/admin/actions');
if (await memberContext(Astro.cookies)) return Astro.redirect('/account/details');

const keys = turnstileKeys();
const error = Astro.url.searchParams.get('error');
const messages: Record<string, string> = {
  invalid: 'Please check your email address.',
  check: 'We couldn’t complete the security check. Please try again.',
  expired: 'That took a little too long, or you’ve been signed out. Please start again.',
};
---

<BaseLayout title="Log in" description="Sign in with an emailed code." currentPath="/login" noindex>
  <main class="container-site px-4 sm:px-6 md:px-8 py-10 md:py-14 max-w-md">
    <h1 class="font-display text-3xl text-ink mb-2">Log in</h1>
    <p class="text-ink-muted mb-8 leading-relaxed">
      For members, friends and church administrators. We’ll email you a 6-digit code. No password.
    </p>

    {error && messages[error] && (
      <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-900 text-sm" role="alert">{messages[error]}</p>
    )}

    {!keys ? (
      <p class="text-ink-muted">Sign-in isn’t available right now.</p>
    ) : (
      <form method="POST" action="/api/auth/login" class="flex flex-col gap-4">
        <Input label="Email" id="email" name="email" type="email" required placeholder="you@example.com" autocomplete="email" />
        <div
          class="cf-turnstile"
          data-sitekey={keys.siteKey}
          data-appearance="interaction-only"
          data-callback="turnstileDone"
          data-expired-callback="turnstileReset"
          data-error-callback="turnstileReset"
        ></div>
        <Button type="submit" id="admin-submit" variant="primary" disabled>Email me a code</Button>
      </form>
    )}
  </main>
  {keys && (
    <>
      <script is:inline>
        window.turnstileDone = () => { document.getElementById('admin-submit').disabled = false; };
        window.turnstileReset = () => { document.getElementById('admin-submit').disabled = true; };
      </script>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
    </>
  )}
</BaseLayout>
