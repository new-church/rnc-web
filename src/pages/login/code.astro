---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import TurnstileGuard from '../../components/TurnstileGuard.astro';
import { loginEmail } from '../../lib/members/session';

if (!loginEmail(Astro.cookies)) return Astro.redirect('/login?error=expired');
const bad = Astro.url.searchParams.get('error') === 'code';
const check = Astro.url.searchParams.get('error') === 'check';
---

<BaseLayout title="Enter your code" currentPath="/login" noindex>
  <main class="container-site px-4 sm:px-6 md:px-8 py-10 md:py-14 max-w-md">
    <h1 class="font-display text-3xl text-ink mb-2">Check your email</h1>
    <p class="text-ink-muted mb-8 leading-relaxed">
      If that address is on our list or is an administrator, we’ve emailed a 6-digit code. It works once and expires in 10 minutes. Check your junk folder if it doesn’t arrive.
    </p>
    {check && (
      <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-900 text-sm" role="alert">We couldn’t complete the security check. Please try again.</p>
    )}
    {bad && (
      <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-900 text-sm" role="alert">That code didn’t work. Please check it, or start again.</p>
    )}
    <form method="POST" action="/api/auth/verify" class="flex flex-col gap-4">
      <label class="flex flex-col gap-1.5 font-display text-sm text-text-heading">
        6-digit code
        <input
          name="code"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9 ]{6,7}"
          maxlength="7"
          required
          class="font-mono text-2xl tracking-[0.3em] text-text-body px-4 py-3 rounded-md border border-border-strong bg-white outline-none focus:border-accent-primary focus:shadow-glow w-48"
        />
      </label>
      <TurnstileGuard buttonId="verify-submit" />
      <div class="flex flex-wrap items-center gap-4">
        <Button type="submit" id="verify-submit" variant="primary" disabled>Log in</Button>
        <a href="/login" class="text-sm text-accent-primary-strong underline">Start again</a>
      </div>
    </form>
  </main>
</BaseLayout>
