---
export const prerender = false;

import type { EmailOtpType } from '@supabase/supabase-js';
import { createSupabaseServerClient } from '../../lib/auth/supabase';
import {
  ensureAppUserAfterLogin,
  userHasAdminAccess,
} from '../../lib/auth/users';

/**
 * Handles the email magic-link redirect (default Supabase template on free plan).
 * Supports PKCE `code` and `token_hash`+`type` (custom templates / some configs).
 */
const url = Astro.url;
const code = url.searchParams.get('code');
const tokenHash = url.searchParams.get('token_hash');
const type = url.searchParams.get('type') as EmailOtpType | null;

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

let authError: string | null = null;

try {
  if (code) {
    const { error } = await supabase.auth.exchangeCodeForSession(code);
    if (error) authError = error.message;
  } else if (tokenHash && type) {
    const { error } = await supabase.auth.verifyOtp({
      token_hash: tokenHash,
      type,
    });
    if (error) authError = error.message;
  } else {
    authError = 'Missing login token. Request a new email from /login.';
  }

  if (!authError) {
    const { data, error } = await supabase.auth.getUser();
    if (error || !data.user?.id || !data.user.email) {
      authError = error?.message ?? 'Signed in, but no user on the session.';
    } else {
      const appUser = await ensureAppUserAfterLogin({
        email: data.user.email,
        authUserId: data.user.id,
        displayName:
          (data.user.user_metadata?.full_name as string | undefined) ?? null,
      });

      if (userHasAdminAccess(appUser)) {
        return Astro.redirect('/admin/contacts');
      }
      return Astro.redirect('/login?error=forbidden');
    }
  }
} catch (err) {
  authError = err instanceof Error ? err.message : String(err);
}

return Astro.redirect(
  `/login?error=${encodeURIComponent(authError ?? 'Login failed')}`,
);
---
