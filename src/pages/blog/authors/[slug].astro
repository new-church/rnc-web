---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SoftPhoto from '../../../components/SoftPhoto.astro';
import Badge from '../../../components/Badge.astro';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { slug: author.id },
    props: { author },
  }));
}

const { author } = Astro.props;

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.author === author.id)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout
  title={author.data.name}
  description={author.data.bio}
  currentPath="/blog"
>
  <main class="container-prose px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <p class="mb-4">
      <a
        href="/blog"
        class="font-display text-sm font-semibold text-accent-primary no-underline hover:underline"
        >← Blog</a
      >
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-[160px_1fr] gap-5 items-start mb-10">
      {
        author.data.photo ? (
          <SoftPhoto
            src={author.data.photo}
            alt={author.data.name}
            aspect="aspect-square"
            class="max-w-[160px]"
          />
        ) : (
          <div class="size-40 rounded-lg bg-violet-100 border border-border-soft" />
        )
      }
      <div>
        <Badge tone="violet">{author.data.role}</Badge>
        <h1 class="mt-3 mb-2 text-h1">{author.data.name}</h1>
        <p class="m-0 text-text-muted">{author.data.bio}</p>
      </div>
    </div>

    <h2 class="text-h2 mt-0 mb-5">Articles</h2>
    {
      posts.length === 0 ? (
        <p class="text-text-muted">No published articles yet.</p>
      ) : (
        <ul class="m-0 pl-0 list-none flex flex-col gap-4">
          {posts.map((post) => (
            <li class="rounded-lg border border-border-soft bg-surface-card p-5 shadow-card">
              <div class="font-display text-eyebrow font-semibold tracking-eyebrow uppercase text-accent-primary mb-1">
                {formatDate(post.data.publishDate)}
              </div>
              <a
                href={`/blog/${post.id}`}
                class="font-display font-semibold text-h3 tracking-display text-text-heading no-underline hover:underline"
              >
                {post.data.title}
              </a>
              <p class="mt-2 mb-0 text-sm text-text-muted">
                {post.data.description}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BaseLayout>
