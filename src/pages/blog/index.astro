---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const authors = await getCollection('authors');
const authorById = new Map(authors.map((a) => [a.id, a]));

const seriesList = [
  ...new Set(posts.map((p) => p.data.series).filter(Boolean) as string[]),
].sort();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout
  title="Blog"
  description="Thoughtful spiritual articles from Roseville New Church — series on life after death, prayer, and more."
  currentPath="/blog"
>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="max-w-[760px]">
      <div
        class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5"
      >
        ✦ Reflections
      </div>
      <h1 class="mt-0 text-h1">Blog</h1>
      <p class="text-lg text-text-muted -mt-1 mb-6">
        Articles organised around the questions people actually ask — with
        pathways you can follow from one piece to the next.
      </p>

      {
        seriesList.length > 0 && (
          <div id="series-filters" class="flex flex-wrap gap-2 mb-10">
            <button
              type="button"
              data-series=""
              class="series-chip font-display text-[13px] px-3 py-1.5 rounded-pill border border-accent-primary bg-violet-100 text-accent-primary-strong"
            >
              All
            </button>
            {seriesList.map((series) => (
              <button
                type="button"
                data-series={series}
                class="series-chip font-display text-[13px] px-3 py-1.5 rounded-pill border border-border-strong text-text-muted hover:border-accent-primary"
              >
                {series}
              </button>
            ))}
          </div>
        )
      }

      <div class="flex flex-col gap-5">
        {
          posts.map((post) => {
            const author = authorById.get(post.data.author);
            return (
              <a
                href={`/blog/${post.id}`}
                class="blog-post block rounded-lg border border-border-soft bg-surface-card shadow-card p-6 no-underline transition-shadow duration-[280ms] ease-[var(--ease-gentle)] hover:shadow-lift"
                data-series={post.data.series ?? ''}
              >
                <div class="flex flex-wrap gap-2 items-center mb-2">
                  {post.data.series && <Badge tone="gold">{post.data.series}</Badge>}
                  <span class="font-display text-eyebrow font-semibold tracking-eyebrow uppercase text-accent-primary">
                    {formatDate(post.data.publishDate)}
                  </span>
                </div>
                <h2 class="m-0 font-display text-h3 tracking-display text-text-heading">
                  {post.data.title}
                </h2>
                <p class="mt-2 mb-0 text-sm text-text-muted">
                  {post.data.description}
                </p>
                {author && (
                  <p class="mt-3 mb-0 text-sm text-text-muted">
                    By{' '}
                    <span class="text-accent-primary-strong">{author.data.name}</span>
                  </p>
                )}
              </a>
            );
          })
        }
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.series-chip');
  const posts = document.querySelectorAll<HTMLElement>('.blog-post');

  function setActive(series: string) {
    chips.forEach((chip) => {
      const active = (chip.dataset.series ?? '') === series;
      chip.classList.toggle('bg-violet-100', active);
      chip.classList.toggle('border-accent-primary', active);
      chip.classList.toggle('text-accent-primary-strong', active);
      chip.classList.toggle('border-border-strong', !active);
      chip.classList.toggle('text-text-muted', !active);
    });
    posts.forEach((post) => {
      const show = !series || post.dataset.series === series;
      post.classList.toggle('hidden', !show);
    });
    const url = new URL(window.location.href);
    if (series) url.searchParams.set('series', series);
    else url.searchParams.delete('series');
    history.replaceState({}, '', url);
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => setActive(chip.dataset.series ?? ''));
  });

  const initial = new URL(window.location.href).searchParams.get('series') ?? '';
  if (initial) setActive(initial);
</script>
