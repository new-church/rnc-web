---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import ArticleCta from '../../components/ArticleCta.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const authors = await getCollection('authors');
const author = authors.find((a) => a.id === post.data.author);

const allPosts = await getCollection('blog');
const related = post.data.relatedPosts
  .map((id) => allPosts.find((p) => p.id === id))
  .filter(Boolean);

const articles = await getCollection('articles');
const relatedArticle = post.data.relatedArticle
  ? articles.find((a) => a.id === post.data.relatedArticle)
  : undefined;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  currentPath="/blog"
>
  <main class="container-prose px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <p class="mb-4">
      <a
        href="/blog"
        class="font-display text-sm font-semibold text-accent-primary no-underline hover:underline"
        >← Blog</a
      >
    </p>

    <article class="prose-rnc">
      <div class="not-prose flex flex-wrap gap-2 items-center mb-3">
        {
          post.data.series && (
            <a
              href={`/blog?series=${encodeURIComponent(post.data.series)}`}
              class="no-underline"
            >
              <Badge tone="gold">{post.data.series}</Badge>
            </a>
          )
        }
        <span
          class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary"
        >
          {formatDate(post.data.publishDate)}
        </span>
      </div>
      <h1>{post.data.title}</h1>
      {
        author && (
          <p class="not-prose -mt-2 mb-6 text-sm text-text-muted">
            By{' '}
            <a
              href={`/blog/authors/${author.id}`}
              class="text-link hover:text-link-hover font-semibold"
            >
              {author.data.name}
            </a>
            {author.data.role && <> · {author.data.role}</>}
          </p>
        )
      }
      <Content />
    </article>

    {
      related.length > 0 && (
        <section class="mt-10">
          <h2 class="text-h3 mt-0 mb-4">Continue reading</h2>
          <ul class="m-0 pl-5 space-y-2 text-text-body">
            {related.map((p) => (
              <li>
                <a
                  href={`/blog/${p!.id}`}
                  class="text-link hover:text-link-hover"
                >
                  {p!.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      relatedArticle && (
        <p class="mt-6 text-sm text-text-muted">
          Related newsletter essay:{' '}
          <a
            href={`/articles/${relatedArticle.id}`}
            class="text-link hover:text-link-hover"
          >
            {relatedArticle.data.title}
          </a>
        </p>
      )
    }

    <ArticleCta />
  </main>
</BaseLayout>
