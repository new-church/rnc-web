---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';

const list = 'mt-3 mb-5 pl-5 list-disc flex flex-col gap-2';
---

<BaseLayout
  title="The Swedenborg Centre"
  description="The Swedenborg Centre is an online service of The Sydney Society of The New Church: talks, discussion and study groups on Swedenborg’s writings."
  currentPath="/about/swedenborg-centre"
>
  <main class="container-prose px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5">
      ✦ About us
    </div>

    <article class="prose-rnc">
      <h1>The Swedenborg Centre</h1>
      <p>
        The Swedenborg Centre is a service of The Sydney Society of The New Church, for anyone who would like to explore
        the writings of Emanuel Swedenborg. From 1 December 2026 it is an online service, open to people across
        Australia and beyond.
      </p>

      <h2>What it offers</h2>
      <ul class={list}>
        <li>Online talks.</li>
        <li>Discussion and study groups.</li>
        <li>Resources on Swedenborg’s writings.</li>
      </ul>

      <h2>Join in</h2>
      <p>
        Two weekly groups are hosted by the Centre, both online via Zoom:
      </p>
      <ul class={list}>
        <li><a href="/events/open-discussion"><strong>Open discussion</strong></a>, Tuesdays, 11am to 1pm. Delve deeper into Swedenborg’s writings and relate them to our lives.</li>
        <li><a href="/events/read-and-reflect"><strong>Read and reflect</strong></a>, Wednesdays, 10am to noon. Reading slowly through one of Swedenborg’s works, together.</li>
      </ul>
      <p>
        The Zoom links and dates are on the Swedenborg Centre website. To hear about talks and events, you can also{' '}
        <a href="/subscribe">join our mailing list</a> and choose the Swedenborg Centre news.
      </p>

      <h2>The Swedenborg Centre website</h2>
      <p>
        The Centre has its own website, where you will find its events, talks and resources.
      </p>
      <div class="mt-5">
        <Button href="https://swedenborg.com.au/">Visit swedenborg.com.au →</Button>
      </div>
      <p class="mt-3 text-sm text-text-muted">It opens in a new tab, so you can come straight back here.</p>

      <h2>Getting in touch</h2>
      <p>
        You can email the Centre at{' '}
        <a href="mailto:info@swedenborg.com.au">info@swedenborg.com.au</a>. The Roseville premises (4 Shirley Rd, the
        Centre’s registered office) are no longer open for drop-in visits.
      </p>
    </article>

    <Card variant="tint" class="mt-12" title="New to Swedenborg?">
      <p class="m-0">
        Our <a href="/about" class="text-link hover:text-link-hover">About page</a> tells the story of the Society and
        what we believe, and you are always welcome to{' '}
        <a href="/events/sunday-worship" class="text-link hover:text-link-hover">worship with us</a>{' '}
        on a Sunday.
      </p>
    </Card>
  </main>
</BaseLayout>
