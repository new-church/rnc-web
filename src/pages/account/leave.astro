---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import AccountNav from '../../components/AccountNav.astro';
import { personContext } from '../../lib/members/guard';
import { isMember } from '../../lib/members/membership';

export const prerender = false;

const ctx = await personContext(Astro.cookies);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { person, session } = ctx;
const error = Astro.url.searchParams.get('error');
---

<BaseLayout title="Deactivate your account" currentPath="/account" noindex>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-10">
    <div class="max-w-[760px]">
      <h1 class="mt-0 mb-4 text-h1">Deactivate your account</h1>
    </div>
    <div class="max-w-[640px]">
      <AccountNav csrf={session.csrf} />
      <Card title="Before you go">
        <ul class="mt-0 mb-4 pl-5">
          <li>You’ll stop receiving all our emails and printed mail.</li>
          <li>We keep a basic record so we can look after our records properly. Ask the office if you’d like anything else removed.</li>
          {isMember(person) && (
            <li>
              <strong>You’re a member</strong>, so this also sends a request to resign. The Committee deals with it at its next meeting and you’ll hear from us.
            </li>
          )}
          <li>You can come back at any time by getting in touch.</li>
        </ul>
        {!isMember(person) && (
          <p class="m-0 mb-4 text-sm text-text-muted">
            If you only want fewer emails, you can{' '}
            <a href="/account/details#mail" class="text-link hover:text-link-hover">change your email choices</a>{' '}
            instead.
          </p>
        )}
        {error === 'confirm' && <p class="m-0 mb-4 font-body text-[14px] text-status-error" role="alert">Please type DEACTIVATE to confirm.</p>}
        {error === 'save' && <p class="m-0 mb-4 font-body text-[14px] text-status-error" role="alert">We couldn’t do that just now. Please try again, or contact us.</p>}
        <form method="post" action="/api/account/deactivate" class="flex flex-col gap-4">
          <input type="hidden" name="csrf" value={session.csrf} />
          <label class="flex flex-col gap-1.5 font-display text-sm text-text-heading">
            Type DEACTIVATE to confirm
            <input name="confirm" autocomplete="off" required class="font-body text-base text-text-body px-4 py-3 rounded-md border border-border-strong bg-white outline-none focus:border-accent-primary focus:shadow-glow w-56" />
          </label>
          <div><Button type="submit" variant="secondary">Deactivate my account</Button></div>
        </form>
      </Card>
    </div>
  </main>
</BaseLayout>
