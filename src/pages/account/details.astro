---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import Input from '../../components/Input.astro';
import ExtraFields from '../../components/ExtraFields.astro';
import AccountNav from '../../components/AccountNav.astro';
import { signupConfig } from '../../lib/signup/config';
import { personContext } from '../../lib/members/guard';
import { isMember } from '../../lib/members/membership';

export const prerender = false;

const ctx = await personContext(Astro.cookies);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { person, session } = ctx;

const sp = Astro.url.searchParams;
const error = sp.get('error');
const errors: Record<string, string> = {
  csrf: 'That form had expired. Please try again.',
  name: 'Please give your first and last name.',
  invalid: sp.get('detail') ?? 'Please check your details.',
  save: 'We couldn’t save that just now. Please try again in a little while, or contact us.',
};
const primaryEmail = person.emails.find((e) => e.primary)?.address ?? person.emails[0]?.address ?? session.email;
---

<BaseLayout title="Your details" description="Manage your details and mailing preferences." currentPath="/account" noindex>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-10">
    <div class="max-w-[760px]">
      <div class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5">
        ✦ Your account
      </div>
      <h1 class="mt-0 mb-4 text-h1">Hello, {person.firstName}</h1>
    </div>
    <div class="max-w-[640px]">
      <AccountNav current="details" csrf={session.csrf} />

      {error && errors[error] && <p class="m-0 mb-4 font-body text-[14px] text-status-error" role="alert">{errors[error]}</p>}
      {sp.get('saved') === '1' && <p class="m-0 mb-4 font-body text-[14px] text-text-heading font-semibold" role="status">Saved. Thank you.</p>}
      {sp.get('unsubscribed') === '1' && (
        <p class="m-0 mb-4 font-body text-[14px] text-text-heading font-semibold" role="status">
          You’re unsubscribed from our emails. Emails already queued may still arrive for up to a day.
        </p>
      )}

      <div class="flex flex-col gap-6">
        <Card title="Your details">
          <form method="post" action="/api/account/save" class="flex flex-col gap-4">
            <input type="hidden" name="csrf" value={session.csrf} />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Input label="First name" id="d-first" name="first" value={person.firstName} required autocomplete="given-name" />
              <Input label="Last name" id="d-last" name="last" value={person.lastName} required autocomplete="family-name" />
            </div>
            <ExtraFields
              idPrefix="d"
              prefix={person.prefix}
              birthdate={person.birthdate}
              phone={person.phone}
              address={person.address}
            />
            <p class="m-0 text-[13px] text-text-muted">
              Your email address is <strong>{primaryEmail}</strong>. To change it, please contact the{' '}
              <a href="/contact" class="text-link hover:text-link-hover">church office</a>. To remove a detail, ask the office as well.
            </p>
            <div><Button type="submit">Save details</Button></div>
          </form>
        </Card>

        <div id="mail">
          <Card title="Your emails">
            {person.unsubscribed && (
              <p class="m-0 mb-4 text-sm text-text-muted">
                You’re currently unsubscribed. If you tick a list and save, Mailchimp will email you a confirmation before sending anything.
              </p>
            )}
            <form method="post" action="/api/account/prefs" class="flex flex-col gap-4">
              <input type="hidden" name="csrf" value={session.csrf} />
              <fieldset class="border-0 p-0 m-0 flex flex-col gap-2.5">
                <legend class="font-display text-sm text-text-heading mb-1">What would you like to receive?</legend>
                {signupConfig.lists.map((l) => (
                  <label class="flex items-start gap-3 font-body text-base text-text-body">
                    <input type="checkbox" name="lists" value={l.id} checked={person.lists.includes(l.option)} class="mt-1.5 h-4 w-4 accent-[var(--color-accent-primary,#5b3fa0)]" />
                    <span>
                      {l.label}
                      <span class="block text-[13px] text-text-muted">{l.hint}</span>
                    </span>
                  </label>
                ))}
              </fieldset>
              <div class="flex flex-wrap items-center gap-3">
                <Button type="submit">Save choices</Button>
                {!person.unsubscribed && (
                  <button type="submit" name="unsubscribe_all" value="1" class="bg-transparent border-0 p-0 font-display text-sm text-link hover:text-link-hover cursor-pointer">
                    Unsubscribe me from all email
                  </button>
                )}
              </div>
            </form>
          </Card>
        </div>

        <Card variant="tint" title="Membership">
          <p class="m-0">
            {isMember(person)
              ? 'You are a member of The Sydney Society of The New Church.'
              : 'You’re a friend of the Society. Anyone is welcome to apply to become a member.'}
          </p>
          <div slot="footer"><Button size="sm" variant="secondary" href="/account/membership">Membership</Button></div>
        </Card>
      </div>
    </div>
  </main>
</BaseLayout>
