---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import { loginEmail } from '../../lib/members/session';

export const prerender = false;

if (!loginEmail(Astro.cookies)) return Astro.redirect('/account?error=expired');
const error = Astro.url.searchParams.get('error');
---

<BaseLayout title="Enter your code" currentPath="/account" noindex>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="max-w-[560px]">
      <div class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5">
        ✦ Your account
      </div>
      <h1 class="mt-0 mb-8 text-h1">Enter your code</h1>
      <Card variant="tint" title="Check your email">
        <p class="m-0 mb-4">
          If that address is on our list, we’ve emailed a 6-digit code. It can take a few minutes, and it’s worth checking your junk folder. It works once and expires in 10 minutes.
        </p>
        {error === 'code' && (
          <p class="m-0 mb-4 font-body text-[14px] text-status-error" role="alert">That code didn’t work. Please check it, or ask for a new one.</p>
        )}
        <form method="post" action="/api/account/verify" class="flex flex-col gap-4">
          <label class="flex flex-col gap-1.5 font-display text-sm text-text-heading">
            6-digit code
            <input
              name="code"
              inputmode="numeric"
              autocomplete="one-time-code"
              pattern="[0-9 ]{6,7}"
              maxlength="7"
              required
              class="font-mono text-2xl tracking-[0.3em] text-text-body px-4 py-3 rounded-md border border-border-strong bg-white outline-none focus:border-accent-primary focus:shadow-glow w-48"
            />
          </label>
          <div class="flex flex-wrap items-center gap-4">
            <Button type="submit">Continue</Button>
            <a href="/account" class="text-sm text-link hover:text-link-hover">Start again</a>
          </div>
        </form>
      </Card>
    </div>
  </main>
</BaseLayout>
