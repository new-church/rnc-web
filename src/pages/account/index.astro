---
// /account used to be a second sign-in page. There is now one front door, /login; this keeps old links and bookmarks
// working. Signed-in pages live under /account/... (details, membership).
import { memberContext } from '../../lib/members/guard';

export const prerender = false;

if (await memberContext(Astro.cookies)) return Astro.redirect('/account/details');
return Astro.redirect(`/login${Astro.url.search}`);
---
