---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { signupConfig } from '../../lib/signup/config';
---

<BaseLayout title="Account deactivated" currentPath="/account" noindex>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="max-w-[560px]">
      <h1 class="mt-0 mb-8 text-h1">Your account is deactivated</h1>
      <Card variant="tint" title="Thank you">
        <p class="m-0">
          You won’t receive our emails. Mail already queued may still arrive for up to a day. If you’d like to come back
          one day, just email{' '}
          <a href={`mailto:${signupConfig.replyTo}`} class="text-link hover:text-link-hover">{signupConfig.replyTo}</a>.
        </p>
        <p class="mt-3 mb-0"><a href="/" class="text-link hover:text-link-hover">Back to the home page</a></p>
      </Card>
    </div>
  </main>
</BaseLayout>
