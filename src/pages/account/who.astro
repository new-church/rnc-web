---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import { memberContext } from '../../lib/members/guard';

export const prerender = false;

const ctx = await memberContext(Astro.cookies);
if (!ctx) return Astro.redirect('/login');
if (ctx.session.personId) return Astro.redirect('/account/details');
const error = Astro.url.searchParams.get('error');
---

<BaseLayout title="Who are you?" currentPath="/account" noindex>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="max-w-[560px]">
      <div class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5">
        ✦ Your account
      </div>
      <h1 class="mt-0 mb-8 text-h1">Who are you?</h1>
      <Card variant="tint" title="This address is shared">
        <p class="m-0 mb-4">More than one person uses this email address. Please choose yourself.</p>
        {error && <p class="m-0 mb-4 font-body text-[14px] text-status-error" role="alert">Please choose one of the names below.</p>}
        <form method="post" action="/api/account/who" class="flex flex-col gap-3">
          <input type="hidden" name="csrf" value={ctx.session.csrf} />
          {
            ctx.session.candidates.map((c) => (
              <label class="flex items-center gap-3 font-body text-base text-text-body">
                <input type="radio" name="person" value={c.id} required class="h-4 w-4" />
                {c.label}
              </label>
            ))
          }
          <div class="mt-2"><Button type="submit">Continue</Button></div>
        </form>
      </Card>
    </div>
  </main>
</BaseLayout>
