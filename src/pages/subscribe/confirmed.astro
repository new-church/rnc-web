---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
---

<BaseLayout title="You’re subscribed" currentPath="/subscribe" noindex analytics>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="max-w-[560px]">
      <h1 class="mt-0 text-h1">You’re subscribed</h1>
      <Card variant="tint" title="Thank you">
        <p class="m-0">
          Your subscription is confirmed. Every email has an unsubscribe link if you ever change your mind.
        </p>
        <p class="mt-3 mb-0"><a href="/" class="text-link hover:text-link-hover">Back to the home page</a></p>
      </Card>
    </div>
  </main>
<script is:inline>
  // Signup conversion for GA4 (no personal details). Mark generate_lead as a key event in GA4.
  window.dataLayer = window.dataLayer || [];
  function gtag() { dataLayer.push(arguments); }
  gtag('event', 'generate_lead', { method: 'mailing_list' });
</script>
</BaseLayout>
