---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import Input from '../../components/Input.astro';
import Select from '../../components/Select.astro';
import ExtraFields from '../../components/ExtraFields.astro';
import AjaxForm from '../../components/AjaxForm.astro';
import { signupErrors } from '../../lib/members/signup';
import { signupConfig } from '../../lib/signup/config';
import { memberConfig } from '../../lib/members/config';
import { apiPath, turnstileKeys } from '../../lib/signup';

export const prerender = false;

const keys = turnstileKeys();
const sp = Astro.url.searchParams;
const sent = sp.get('sent') === '1';
const error = sp.get('error');
const messages = signupErrors;
const detail = sp.get('detail');
---

<BaseLayout
  title="Join our mailing list"
  description="Get news from Roseville New Church and the Swedenborg Centre by email."
  currentPath="/subscribe"
>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="max-w-[760px]">
      <div class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5">
        ✦ Stay in touch
      </div>
      <h1 class="mt-0 mb-4 text-h1">Join our mailing list</h1>
      <p class="text-lg text-text-muted mt-0 mb-8">
        Choose what you’d like to hear about. We’ll email you a link to confirm, and every message has an unsubscribe link.
      </p>
    </div>

    <div class="max-w-[560px]">
      {!sent && (
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-md border border-border-soft bg-white px-5 py-4">
          <p class="m-0 text-sm text-text-body">
            <strong class="font-display text-text-heading">Already on our list?</strong> Log in to manage your details,
            choose your emails, or apply to become a member.
          </p>
          <Button size="sm" variant="secondary" href="/login">Log in</Button>
        </div>
      )}
      {sent ? (
        <Card variant="tint" title="Check your email">
          <p class="m-0">
            We’ve sent you a confirmation email. Open it and press the button to finish subscribing. It can take a
            few minutes, and it’s worth checking your junk folder.
          </p>
        </Card>
      ) : !keys ? (
        <Card title="Sign-up is unavailable">
          <p class="m-0">
            Sorry, sign-up isn’t working at the moment. Please email{' '}
            <a href={`mailto:${signupConfig.replyTo}`} class="text-link hover:text-link-hover">{signupConfig.replyTo}</a>{' '}
            and we’ll add you.
          </p>
        </Card>
      ) : (
        <Card variant="tint" title="Your details">
          {error && (messages[error] || detail) && (
            <p class="m-0 mb-4 font-body text-[14px] text-status-error" role="alert">{(error === 'invalid' && detail) || messages[error]}</p>
          )}
          <p id="subscribe-form-error" hidden class="m-0 mb-4 font-body text-[14px] text-status-error" role="alert"></p>
          <form id="subscribe-form" method="post" action={apiPath()} class="flex flex-col gap-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Input label="First name" id="sub-first" name="first" autocomplete="given-name" required />
              <Input label="Last name" id="sub-last" name="last" autocomplete="family-name" required />
            </div>
            <Input label="Email" id="sub-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />

            <fieldset class="border-0 p-0 m-0 flex flex-col gap-2.5">
              <legend class="font-display text-sm text-text-heading mb-1">What would you like to receive?</legend>
              {signupConfig.lists.map((l) => (
                <label class="flex items-start gap-3 font-body text-base text-text-body">
                  <input type="checkbox" name="lists" value={l.id} checked={l.checked} class="mt-1.5 h-4 w-4 accent-[var(--color-accent-primary,#5b3fa0)]" />
                  <span>
                    {l.label}
                    <span class="block text-[13px] text-text-muted">{l.hint}</span>
                  </span>
                </label>
              ))}
            </fieldset>

            <div class="flex flex-col gap-2">
              <Select label="How did you hear about us? (optional)" id="sub-source" name="source">
                <option value="">Choose one…</option>
                {memberConfig.signupSources.map((o) => <option value={o.id}>{o.label}</option>)}
              </Select>
              <div id="sub-source-other" hidden>
                <Input label="Tell us a little more" id="sub-source-other-text" name="sourceOther" placeholder="e.g. a website, a talk, a person" />
              </div>
            </div>

            <details class="rounded-md border border-border-soft bg-white px-4 py-3">
              <summary class="cursor-pointer font-display text-sm text-text-heading">Add more details (optional)</summary>
              <p class="mt-3 mb-4 text-[13px] text-text-muted">
                Only if you’d like us to have them: they help us keep our records right and post you printed items. You can change or remove them later from your details page.
              </p>
              <ExtraFields idPrefix="sub" />
            </details>

            <div
              class="cf-turnstile"
              data-sitekey={keys.siteKey}
              data-appearance="interaction-only"
              data-callback="turnstileDone"
              data-expired-callback="turnstileReset"
              data-error-callback="turnstileReset"
            ></div>
            <Button type="submit" id="subscribe-submit" disabled>Send confirmation email</Button>
            <p class="m-0 text-[13px] text-text-muted">
              See our <a href="/privacy" class="text-link hover:text-link-hover">privacy page</a> for how we use your details.
            </p>
          </form>
        </Card>
      )}
      {!sent && (
        <p class="mt-5 mb-0 text-sm text-text-muted">
          Joining also creates your record. Once you’ve confirmed your email, you can{' '}
          <a href="/login" class="text-link hover:text-link-hover">log in</a>{' '}
          with the same address to see and change your details, choose your emails, or apply to become a member.
        </p>
      )}
    </div>
  </main>
  {keys && !sent && (
    <>
      <script is:inline>
        // The button stays off until Turnstile has passed the visitor (usually instantly and invisibly).
        window.turnstileDone = () => { document.getElementById('subscribe-submit').disabled = false; };
        window.turnstileReset = () => { document.getElementById('subscribe-submit').disabled = true; };
        // A short text box appears only for "Other".
        document.getElementById('sub-source').addEventListener('change', (e) => {
          document.getElementById('sub-source-other').hidden = e.target.value !== 'other';
        });
      </script>
      <AjaxForm formId="subscribe-form" />
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
    </>
  )}
</BaseLayout>
