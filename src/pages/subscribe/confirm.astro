---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import { apiPath, listsFor, readToken, signupPath } from '../../lib/signup';
import { memberKv } from '../../lib/members/kv';
import { readSignup } from '../../lib/members/signup';

export const prerender = false;

// The link holds a secret reference, so never pass its path or token on as a Referer (the next page loads
// Google Analytics): send only the site's origin. Do NOT use 'no-referrer': it makes browsers send "Origin: null" on
// the Confirm form post, and Astro's cross-site check then rejects it ("Cross-site POST form submissions are forbidden").
Astro.response.headers.set('Referrer-Policy', 'strict-origin');

const ref = Astro.url.searchParams.get('s') ?? '';
const t = Astro.url.searchParams.get('t') ?? '';
// New links carry a random reference (s); links emailed before the change carry a signed token (t) and still work.
const sub = ref ? await readSignup(memberKv(), ref) : readToken(t);
const failed = Astro.url.searchParams.get('error') === 'failed';
---

<BaseLayout title="Confirm your subscription" currentPath="/subscribe" noindex>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="max-w-[560px]">
      <div class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5">
        ✦ Stay in touch
      </div>
      <h1 class="mt-0 mb-8 text-h1">Confirm your subscription</h1>
      {sub ? (
        <Card variant="tint" title={`Hello ${sub.first}`}>
          {failed && (
            <p class="m-0 mb-4 font-body text-[14px] text-status-error" role="alert">
              Something went wrong saving your subscription. Please press the button to try again.
            </p>
          )}
          <p class="m-0">Press the button to receive:</p>
          <ul class="mt-2 mb-5">
            {listsFor(sub.lists).map((l) => <li>{l.label}</li>)}
          </ul>
          <form method="post" action={apiPath('/confirm')}>
            {ref ? <input type="hidden" name="s" value={ref} /> : <input type="hidden" name="t" value={t} />}
            <Button type="submit">Confirm my subscription</Button>
          </form>
        </Card>
      ) : (
        <Card title="This link has expired">
          <p class="m-0">
            This confirmation link isn’t valid any more. Please{' '}
            <a href={signupPath()} class="text-link hover:text-link-hover">sign up again</a>{' '}
            and we’ll send a new one.
          </p>
        </Card>
      )}
    </div>
  </main>
</BaseLayout>
