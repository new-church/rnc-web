---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { requireAdminSession } from '../../lib/auth/session';
import { listAppUsers } from '../../lib/auth/users';

const gate = await requireAdminSession({
  request: Astro.request,
  cookies: Astro.cookies,
});

if (gate instanceof Response) {
  return gate;
}

const users = await listAppUsers();
---

<BaseLayout
  title="Users"
  description="Application users and permission scopes."
  currentPath="/admin/users"
>
  <main class="container-site px-4 sm:px-6 md:px-8 py-10 md:py-14 max-w-3xl">
    <div class="flex flex-wrap items-start justify-between gap-4 mb-8">
      <div>
        <p class="font-display text-sm tracking-wide text-violet-700 mb-2">Admin</p>
        <h1 class="font-display text-3xl md:text-4xl text-ink mb-2">Users</h1>
        <p class="text-ink-muted leading-relaxed">
          Signed in as {gate.email}. Scopes live on <code class="text-sm">USER#… / PROFILE</code> items.
        </p>
      </div>
      <form method="POST" action="/api/auth/logout">
        <Button type="submit" variant="secondary" size="sm">Log out</Button>
      </form>
    </div>

    {
      users.length === 0 ? (
        <p class="text-ink-muted">
          No user rows yet. Seed a <code class="text-sm">USER#… / PROFILE</code> item
          with scopes (see migrations), then log in with that email.
        </p>
      ) : (
        <div class="overflow-x-auto rounded-lg border border-border-soft bg-white">
          <table class="w-full text-left text-sm">
            <thead class="border-b border-border-soft bg-violet-50 font-display text-text-heading">
              <tr>
                <th class="px-4 py-3 font-semibold">Email</th>
                <th class="px-4 py-3 font-semibold">Scopes</th>
                <th class="px-4 py-3 font-semibold">Auth linked</th>
              </tr>
            </thead>
            <tbody>
              {
                users.map((u) => (
                  <tr class="border-b border-border-soft last:border-0">
                    <td class="px-4 py-3 align-top">
                      <div class="font-medium text-ink">{u.data.email}</div>
                      {
                        u.data.displayName && (
                          <div class="text-ink-muted text-xs mt-0.5">{u.data.displayName}</div>
                        )
                      }
                    </td>
                    <td class="px-4 py-3 align-top">
                      {
                        u.data.scopes.length === 0 ? (
                          <span class="text-ink-muted">none</span>
                        ) : (
                          <ul class="flex flex-wrap gap-1.5">
                            {u.data.scopes.map((s) => (
                              <li class="rounded-full bg-violet-100 px-2.5 py-0.5 text-xs font-display text-violet-900">
                                {s}
                              </li>
                            ))}
                          </ul>
                        )
                      }
                    </td>
                    <td class="px-4 py-3 align-top text-ink-muted font-mono text-xs break-all">
                      {u.data.authUserId ?? '—'}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      )
    }
  </main>
</BaseLayout>
