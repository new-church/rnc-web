---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { listAppUsers } from '../../lib/auth/users';

const session = Astro.locals.adminSession!;
const users = await listAppUsers();
---

<AdminLayout
  title="Users"
  currentPath={Astro.url.pathname}
  email={session.email}
>
  <p class="text-ink-muted mb-6 max-w-2xl leading-relaxed">
    Login accounts and permission scopes (<code class="text-sm">USER#… / PROFILE</code>).
    Seed or edit scopes to grant admin access.
  </p>

  {
    users.length === 0 ? (
      <p class="text-ink-muted">No user rows yet.</p>
    ) : (
      <div class="overflow-x-auto rounded-lg border border-border-soft bg-white">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-border-soft bg-violet-50 font-display text-text-heading">
            <tr>
              <th class="px-4 py-3 font-semibold">Email</th>
              <th class="px-4 py-3 font-semibold">Scopes</th>
              <th class="px-4 py-3 font-semibold">Auth linked</th>
            </tr>
          </thead>
          <tbody>
            {
              users.map((u) => (
                <tr class="border-b border-border-soft last:border-0 hover:bg-violet-50/50">
                  <td class="px-4 py-3 align-top">
                    <a
                      href={`/admin/users/${encodeURIComponent(u.data.email)}`}
                      class="font-medium text-accent-primary-strong no-underline hover:underline"
                    >
                      {u.data.email}
                    </a>
                    {
                      u.data.displayName && (
                        <div class="text-ink-muted text-xs mt-0.5">
                          {u.data.displayName}
                        </div>
                      )
                    }
                  </td>
                  <td class="px-4 py-3 align-top">
                    {
                      u.data.scopes.length === 0 ? (
                        <span class="text-ink-muted">none</span>
                      ) : (
                        <ul class="flex flex-wrap gap-1.5">
                          {u.data.scopes.map((s) => (
                            <li class="rounded-full bg-violet-100 px-2.5 py-0.5 text-xs font-display text-violet-900">
                              {s}
                            </li>
                          ))}
                        </ul>
                      )
                    }
                  </td>
                  <td class="px-4 py-3 align-top text-ink-muted font-mono text-xs break-all">
                    {u.data.authUserId ?? '—'}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
