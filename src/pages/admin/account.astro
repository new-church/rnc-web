---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import AccountForm from '../../components/admin/AccountForm';
import { updateAppUser } from '../../lib/auth/users';

const session = Astro.locals.adminSession!;
let notice = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const displayName = String(form.get('displayName') ?? '').trim();
  if (!displayName) {
    error = 'Display name is required.';
  } else {
    try {
      await updateAppUser({
        email: session.email,
        displayName,
      });
      notice = 'Saved.';
      if (session.appUser) {
        session.appUser.data.displayName = displayName;
      }
    } catch (err) {
      error = err instanceof Error ? err.message : String(err);
    }
  }
}

const displayName =
  session.appUser?.data.displayName ?? session.email.split('@')[0] ?? '';
---

<AdminLayout
  title="Account"
  currentPath={Astro.url.pathname}
  email={session.email}
>
  <p class="text-ink-muted mb-6 max-w-xl leading-relaxed">
    Your login profile. Email is fixed by authentication.
  </p>
  {
    error && (
      <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-900 text-sm">
        {error}
      </p>
    )
  }
  {
    notice && (
      <p class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-green-900 text-sm">
        {notice}
      </p>
    )
  }
  <AccountForm
    client:load
    email={session.email}
    displayName={displayName}
  />
</AdminLayout>
