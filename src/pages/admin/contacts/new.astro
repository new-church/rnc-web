---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import ContactForm from '../../../components/admin/ContactForm';
import { putContact, contactDataFromFormData } from '../../../lib/contacts';

const session = Astro.locals.adminSession!;
let error = '';

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData();
    const data = contactDataFromFormData(form);
    const id = crypto.randomUUID();
    await putContact({ id, data });
    return Astro.redirect(`/admin/contacts/${id}`);
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}
---

<AdminLayout
  title="New contact"
  currentPath={Astro.url.pathname}
  email={session.email}
>
  <p class="mb-6">
    <a
      href="/admin/contacts"
      class="text-sm text-accent-primary-strong no-underline hover:underline"
    >
      ← Contacts
    </a>
  </p>
  {
    error && (
      <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-900 text-sm">
        {error}
      </p>
    )
  }
  <ContactForm client:load action="/admin/contacts/new" submitLabel="Create contact" />
</AdminLayout>
