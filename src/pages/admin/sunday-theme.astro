---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import {
  clearSundayTheme,
  formatServiceDate,
  getSundayTheme,
  saveSundayTheme,
} from '../../lib/site/sunday-theme';

const session = Astro.locals.adminSession!;
let notice = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    if (form.get('intent') === 'clear') {
      await clearSundayTheme();
      notice = 'Cleared. No theme is shown on the site.';
    } else {
      const serviceDate = String(form.get('serviceDate') ?? '').trim();
      const theme = String(form.get('theme') ?? '').trim();
      const note = String(form.get('note') ?? '').trim();
      if (!/^\d{4}-\d{2}-\d{2}$/.test(serviceDate)) {
        error = 'Choose the date of the service.';
      } else if (!theme) {
        error = 'Enter the theme.';
      } else if (theme.length > 120 || note.length > 300) {
        error = 'Theme up to 120 characters, note up to 300.';
      } else {
        await saveSundayTheme({
          serviceDate,
          theme,
          note: note || undefined,
          updatedBy: session.email,
        });
        notice = 'Saved. It shows on the home page and the Sunday worship page until that Sunday has passed.';
      }
    }
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}

const current = await getSundayTheme().catch(() => null);
---

<AdminLayout
  title="Sunday theme"
  currentPath={Astro.url.pathname}
  email={session.email}
>
  <p class="text-ink-muted mb-6 max-w-xl leading-relaxed">
    The theme of the next Sunday service, shown on the home page and beside the
    Sunday worship details. It disappears by itself once that Sunday has passed,
    so remember to set the next one.
  </p>
  {
    error && (
      <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-900 text-sm">
        {error}
      </p>
    )
  }
  {
    notice && (
      <p class="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-green-900 text-sm">
        {notice}
      </p>
    )
  }
  {
    current && (
      <p class="mb-6 text-sm text-ink-muted">
        Currently set: <strong>{formatServiceDate(current.serviceDate)}</strong> —{' '}
        {current.theme}
        {current.updatedBy ? ` (by ${current.updatedBy})` : ''}
      </p>
    )
  }
  <form method="POST" class="max-w-xl flex flex-col gap-4">
    <label class="flex flex-col gap-1 text-sm">
      <span class="font-display font-semibold">Service date</span>
      <input
        type="date"
        name="serviceDate"
        required
        value={current?.serviceDate ?? ''}
        class="rounded-md border border-border-soft bg-white px-3 py-2"
      />
    </label>
    <label class="flex flex-col gap-1 text-sm">
      <span class="font-display font-semibold">Theme</span>
      <input
        type="text"
        name="theme"
        required
        maxlength="120"
        value={current?.theme ?? ''}
        placeholder="e.g. The Lord's Prayer: giving us our daily bread"
        class="rounded-md border border-border-soft bg-white px-3 py-2"
      />
    </label>
    <label class="flex flex-col gap-1 text-sm">
      <span class="font-display font-semibold">Readings or a line about it (optional)</span>
      <textarea
        name="note"
        rows="3"
        maxlength="300"
        class="rounded-md border border-border-soft bg-white px-3 py-2"
      >{current?.note ?? ''}</textarea>
    </label>
    <div class="flex gap-3">
      <button
        type="submit"
        class="inline-flex items-center justify-center font-display font-semibold tracking-[0.04em] rounded-pill bg-accent-primary text-text-on-accent px-[22px] pt-[11px] pb-[9px] text-[14px] leading-none hover:bg-accent-primary-strong"
      >
        Save
      </button>
      <button
        type="submit"
        name="intent"
        value="clear"
        formnovalidate
        class="inline-flex items-center justify-center font-display font-semibold tracking-[0.04em] rounded-pill border border-border-soft bg-white px-[22px] pt-[11px] pb-[9px] text-[14px] leading-none hover:bg-gray-50"
      >
        Clear
      </button>
    </div>
  </form>
</AdminLayout>
