---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import SoftPhoto from '../components/SoftPhoto.astro';

export const prerender = false;

Astro.response.status = 404;

const links = [
  { href: '/events/sunday-worship', title: 'Join us on Sunday', text: 'Worship on the 1st and 3rd Sundays at 10am.' },
  { href: '/events', title: 'Upcoming events', text: 'Services, discussion groups and what’s on next.' },
  { href: '/newsletters', title: 'Newsletters', text: 'Past issues of our bulletin to read or download.' },
  { href: '/contact', title: 'Contact us', text: 'Our address, phone and email, and an enquiry form.' },
];
---

<BaseLayout
  title="Page not found"
  description="Sorry, we couldn’t find that page."
  currentPath="/404"
  noindex
>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_380px] gap-8 lg:gap-14 items-start">
      <div>
        <div
          class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5"
        >
          ✦ Page not found
        </div>
        <h1 class="mt-0 mb-4 text-h1">We can’t find that page</h1>
        <p class="text-lg text-text-muted mt-0 mb-8 max-w-[560px]">
          Sorry about that. The page may have moved when we updated the
          website, or the link may have a typo. Here are some places to start.
        </p>

        <div class="flex flex-wrap gap-3 mb-10">
          <Button href="/">Back to the home page</Button>
          <Button variant="secondary" href="/contact">Contact us</Button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-[640px]">
          {
            links.map((l) => (
              <Card href={l.href} interactive title={l.title}>
                <p class="m-0 text-sm text-text-muted">{l.text}</p>
              </Card>
            ))
          }
        </div>
      </div>

      <SoftPhoto
        src="/images/church/exterior.jpg"
        alt="Roseville New Church exterior on Shirley Road"
        aspect="aspect-[4/5]"
        class="max-lg:hidden"
      />
    </div>
  </main>
</BaseLayout>
