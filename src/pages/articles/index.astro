---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout
  title="Articles"
  description="Standalone essays drawn from Roseville New Church newsletters — thoughtful spirituality for seekers and members."
  currentPath="/articles"
>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="max-w-[760px]">
      <div
        class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5"
      >
        ✦ From the newsletters
      </div>
      <h1 class="mt-0 text-h1">Articles</h1>
      <p class="text-lg text-text-muted -mt-1 mb-10">
        Evergreen pieces highlighted from the newsletter archive. Full
        transcriptions will replace stubs over time — each article links back to
        its source PDF.
      </p>

      <div class="flex flex-col gap-5">
        {
          articles.map((article) => (
            <a
              href={`/articles/${article.id}`}
              class="block rounded-lg border border-border-soft bg-surface-card shadow-card p-6 no-underline transition-shadow duration-[280ms] ease-[var(--ease-gentle)] hover:shadow-lift"
            >
              <div class="font-display text-eyebrow font-semibold tracking-eyebrow uppercase text-accent-primary mb-2">
                {formatDate(article.data.date)}
              </div>
              <h2 class="m-0 font-display text-h3 tracking-display text-text-heading">
                {article.data.title}
              </h2>
              <p class="mt-2 mb-0 text-sm text-text-muted">
                {article.data.description}
              </p>
              {article.data.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {article.data.tags.map((tag) => (
                    <Badge tone="violet">{tag}</Badge>
                  ))}
                </div>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
