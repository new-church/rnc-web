---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import ArticleCta from '../../components/ArticleCta.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter((a) => !a.data.draft)
    .map((article) => ({
      params: { slug: article.id },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const newsletters = await getCollection('newsletters');
const source = article.data.sourceNewsletter
  ? newsletters.find((n) => n.id === article.data.sourceNewsletter)
  : undefined;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  currentPath="/articles"
>
  <main class="container-prose px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <p class="mb-4">
      <a
        href="/articles"
        class="font-display text-sm font-semibold text-accent-primary no-underline hover:underline"
        >← Articles</a
      >
    </p>
    <article class="prose-rnc">
      <div
        class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5 !mt-0"
      >
        {formatDate(article.data.date)}
      </div>
      <h1>{article.data.title}</h1>
      {
        article.data.tags.length > 0 && (
          <div class="not-prose flex flex-wrap gap-2 mb-6">
            {article.data.tags.map((tag) => (
              <Badge tone="violet">{tag}</Badge>
            ))}
          </div>
        )
      }
      <Content />
    </article>

    {
      source && (
        <div class="mt-8 rounded-lg border border-border-soft bg-surface-tint p-5">
          <div class="font-display text-sm font-semibold text-text-heading">
            From the newsletter
          </div>
          <p class="mt-1 mb-3 text-sm text-text-muted">
            Originally published in {source.data.title}.
          </p>
          <Button size="sm" variant="secondary" href={source.data.pdfUrl}>
            Download PDF
          </Button>
          <Button size="sm" variant="secondary" href="/newsletters" class="ml-2">
            Browse archive
          </Button>
        </div>
      )
    }

    <ArticleCta />
  </main>
</BaseLayout>
