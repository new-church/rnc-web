---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Badge from '../../components/Badge.astro';
---

<BaseLayout
  title="Join us"
  description="Join Roseville New Church for Sunday worship, midweek discussions, meditation, and community events."
  currentPath="/join"
>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="max-w-[760px]">
      <div
        class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5"
      >
        ✦ You’re welcome here
      </div>
      <h1 class="mt-0 text-h1">Join us</h1>
      <p class="text-lg text-text-muted -mt-1 mb-10">
        Choose how you’d like to take part — Sunday worship at the church, or
        midweek sessions hosted by the Swedenborg Centre next door.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-14">
      <Card
        interactive
        href="/join/sunday-worship"
        eyebrow="1st & 3rd Sundays · 10am"
        title="Sunday worship"
      >
        Everything you need to know if you’re interested in joining us on a
        Sunday.
        <Badge slot="footer" tone="gold">Morning tea after</Badge>
      </Card>
      <Card
        interactive
        href="/join/open-discussion"
        eyebrow="Tuesdays · 11am"
        title="Open discussion"
      >
        Friendly conversation exploring Swedenborg and other wisdom traditions —
        in person or on Zoom.
        <Badge slot="footer" tone="info">In person / Zoom</Badge>
      </Card>
      <Card
        interactive
        href="/join/read-and-reflect"
        eyebrow="Wednesdays · 10am"
        title="Read & reflect"
      >
        Read and discuss passages from Swedenborg’s writings together — currently
        exploring True Christianity.
        <Badge slot="footer" tone="info">In person / Zoom</Badge>
      </Card>
    </div>

    <h2 class="text-h2 mt-0 mb-5">Also happening</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-14">
      <Card
        interactive
        href="/join/meditation"
        eyebrow="Mondays · 10am"
        title="Meditation"
      >
        Quiet meditation in the church sanctuary with Kathryn Baker.
        <Badge slot="footer" tone="success">In person</Badge>
      </Card>
      <Card
        interactive
        href="/join/family-retreat-2027"
        eyebrow="22–26 January 2027"
        title="Family retreat"
      >
        New Church in Australia Family Retreat at The Tops, Stanwell Tops.
        <Badge slot="footer" tone="gold">All ages</Badge>
      </Card>
      <Card variant="tint" eyebrow="Community" title="Movie night">
        <p class="m-0 text-sm text-text-muted">
          Details coming soon — check back or ask at the church office.
        </p>
        <Badge slot="footer" tone="violet">Placeholder</Badge>
      </Card>
    </div>

    <p class="text-text-muted max-w-[640px]">
      Looking for dated calendar items? See{' '}
      <a href="/events" class="text-link hover:text-link-hover">upcoming events</a
      >, or{' '}
      <a href="/contact" class="text-link hover:text-link-hover">contact us</a> if
      you have a question before your first visit.
    </p>
  </main>
</BaseLayout>
