---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Input from '../components/Input.astro';
import SoftPhoto from '../components/SoftPhoto.astro';
import { turnstileKeys } from '../lib/signup';

export const prerender = false;

const keys = turnstileKeys();
const sp = Astro.url.searchParams;
const sent = sp.get('sent') === '1';
const error = sp.get('error');
const messages: Record<string, string> = {
  invalid: 'Please check your name, email address and message.',
  check: 'We couldn’t complete the security check. Please try again.',
  send: 'We couldn’t send your message just now. Please try again in a little while, or email us directly.',
};
---

<BaseLayout
  title="Contact us"
  description="Get in touch with Roseville New Church — address, phone, email, and a simple enquiry form."
  currentPath="/contact"
>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <div class="max-w-[760px]">
      <div
        class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5"
      >
        ✦ Get in touch
      </div>
      <h1 class="mt-0 mb-4 text-h1">Contact us</h1>
      <p class="text-lg text-text-muted mt-0 mb-10">
        We welcome you to visit our church, or contact us if you have any
        questions.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-x-12 lg:gap-y-5 items-start">
      <div class="flex flex-col gap-5 lg:col-start-1 lg:row-start-1">
        <SoftPhoto
          src="/images/church/exterior.jpg"
          alt="Roseville New Church exterior on Shirley Road"
          aspect="aspect-[16/10]"
          class="max-lg:hidden"
        />

        <Card title="Visit us">
          <p class="m-0">
            Roseville New Church<br />
            2B Shirley Rd<br />
            Roseville NSW 2069
          </p>
          <p class="mt-3 mb-0 text-sm text-text-muted">
            Ten minutes’ walk from Roseville Station. Worship on the 1st and 3rd
            Sundays at 10am.
          </p>
          <div slot="footer" class="flex flex-wrap gap-3">
            <Button
              size="sm"
              href="https://maps.app.goo.gl/f81HYmHGPyfxKE566"
            >
              Get directions
            </Button>
            <Button size="sm" variant="secondary" href="/events/sunday-worship">
              Plan a Sunday visit
            </Button>
          </div>
        </Card>

        <Card title="Contact the church">
          <dl class="m-0 grid grid-cols-1 sm:grid-cols-[6.5rem_1fr] gap-x-4 gap-y-0.5 sm:gap-y-3">
            <dt class="text-sm text-text-muted">Phone</dt>
            <dd class="m-0 mb-3 sm:mb-0">
              <a href="tel:+61294167026" class="text-link hover:text-link-hover">02 9416 7026</a>
            </dd>
            <dt class="text-sm text-text-muted">Church office</dt>
            <dd class="m-0 mb-3 sm:mb-0">
              <a
                href="mailto:admin@rosevillenewchurch.com.au"
                class="text-link hover:text-link-hover break-all"
                >admin@rosevillenewchurch.com.au</a
              >
            </dd>
            <dt class="text-sm text-text-muted">Minister</dt>
            <dd class="m-0">
              <a
                href="mailto:pastor@rosevillenewchurch.com.au"
                class="text-link hover:text-link-hover break-all"
                >pastor@rosevillenewchurch.com.au</a
              >
            </dd>
          </dl>

          <div class="mt-5 rounded-md bg-surface-tint border border-border-soft px-4 py-3">
            <div class="font-display font-semibold text-sm text-text-heading mb-1">Postal address</div>
            <p class="m-0">
              Sydney Society of the New Church<br />
              4 Shirley Rd, Roseville NSW 2069
            </p>
            <p class="mt-2 mb-0 text-sm text-text-muted">
              Please send mail here, not to the church building at 2B Shirley
              Rd. The church can’t receive mail, so anything sent there is
              likely to be returned to sender.
            </p>
          </div>

          <div slot="footer" class="flex flex-wrap gap-3">
            <Button size="sm" variant="secondary" href="/subscribe">Join our mailing list</Button>
            <Button size="sm" variant="secondary" href="/give">Give to the church</Button>
          </div>
        </Card>
      </div>

      <Card variant="tint" title="General enquiry" class="lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-24">
        <div id="enquiry"></div>
        {
          sent ? (
            <p class="m-0">
              Thank you. Your message has been sent to the church office, and we’ll reply to the email address you gave us.
            </p>
          ) : !keys ? (
            <p class="m-0">
              Sorry, the enquiry form isn’t working at the moment. Please email{' '}
              <a href="mailto:admin@rosevillenewchurch.com.au" class="text-link hover:text-link-hover break-all">admin@rosevillenewchurch.com.au</a>{' '}
              instead.
            </p>
          ) : (
            <>
              <p class="m-0 mb-5 text-sm text-text-muted">
                Send a message to the church office and we’ll reply by email.
              </p>
              {error && messages[error] && (
                <p class="m-0 mb-4 font-body text-[14px] text-status-error" role="alert">{messages[error]}</p>
              )}
              <form method="post" action="/api/contact" class="flex flex-col gap-4">
                <Input label="Your name" id="contact-name" name="name" autocomplete="name" required placeholder="Your name" />
                <Input label="Your email" id="contact-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
                <Input label="Subject" id="contact-subject" name="subject" placeholder="How can we help?" />
                <label class="flex flex-col gap-1.5 font-display text-sm text-text-heading">
                  Your message
                  <textarea
                    id="contact-message"
                    name="message"
                    required
                    rows="5"
                    maxlength="5000"
                    placeholder="Write your message…"
                    class="font-body text-base text-text-body px-4 py-3 rounded-md border border-border-strong bg-white outline-none transition-[box-shadow,border-color] duration-150 ease-[var(--ease-gentle)] focus:border-accent-primary focus:shadow-glow resize-y min-h-[120px]"
                  ></textarea>
                </label>
                <div
                  class="cf-turnstile"
                  data-sitekey={keys.siteKey}
                  data-appearance="interaction-only"
                  data-callback="turnstileDone"
                  data-expired-callback="turnstileReset"
                  data-error-callback="turnstileReset"
                ></div>
                <Button type="submit" id="contact-submit" disabled>Send message</Button>
                <p class="m-0 text-[13px] text-text-muted">
                  See our <a href="/privacy" class="text-link hover:text-link-hover">privacy page</a> for how we use your details.
                </p>
              </form>
            </>
          )
        }
      </Card>

      <div class="flex flex-col gap-5 lg:col-start-1 lg:row-start-2">
        <Card title="Swedenborg Centre">
          <p class="m-0">
            From 1 December 2026 the Swedenborg Centre is an online service —
            talks, discussion and study groups, and resources on Swedenborg’s
            writings, for people across Australia and beyond.
          </p>
          <p class="mt-3 mb-0 text-sm text-text-muted">
            The Roseville premises (4 Shirley Rd, the Centre’s registered
            office) are no longer open for drop-in visits. Please get in touch
            by email at{' '}
            <a href="mailto:info@swedenborg.com.au" class="text-link hover:text-link-hover"
              >info@swedenborg.com.au</a
            >{' '}
            or through the website.
          </p>
          <div slot="footer">
            <Button
              size="sm"
              variant="secondary"
              href="https://swedenborg.com.au/"
            >
              swedenborg.com.au →
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </main>
</BaseLayout>

{
  keys && !sent && (
    <>
      <script is:inline>
        // The send button stays off until Turnstile has passed the visitor (usually instantly and invisibly).
        window.turnstileDone = () => { document.getElementById('contact-submit').disabled = false; };
        window.turnstileReset = () => { document.getElementById('contact-submit').disabled = true; };
      </script>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
    </>
  )
}
