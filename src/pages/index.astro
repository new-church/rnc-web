---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Input from '../components/Input.astro';
import { Sunrise } from '@lucide/astro';
---

<BaseLayout
  description="A Swedenborgian community in Sydney — worshipping the Lord Jesus Christ and exploring His love and wisdom together."
  currentPath="/"
>
  <main>
    <!-- Hero -->
    <section class="bg-gradient-dawn border-b border-border-soft">
      <div
        class="container-site px-6 md:px-8 pt-16 md:pt-24 pb-14 md:pb-[88px] text-center"
      >
        <div
          class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-[18px]"
        >
          ✦ A Swedenborgian community in Sydney ✦
        </div>
        <h1
          class="mx-auto font-light text-hero max-w-[820px] text-text-heading"
        >
          A place to seek, question, and{' '}
          <span class="text-gradient-aurora font-semibold">grow in light</span>
        </h1>
        <p
          class="max-w-[560px] mx-auto mt-[22px] mb-[34px] text-lg text-text-muted"
        >
          We explore the Bible and the nature of God through the writings of
          Emanuel Swedenborg — and we'd love you to join us.
        </p>
        <div
          class="flex flex-col sm:flex-row gap-3 justify-center items-center"
        >
          <Button size="lg" href="/about#visit">Plan a visit</Button>
          <Button size="lg" variant="secondary" href="/about"
            >What we believe</Button
          >
        </div>
      </div>
    </section>

    <!-- This week / regular rhythm -->
    <section class="container-site px-6 md:px-8 pt-14 md:pt-[72px]">
      <div
        class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 mb-6"
      >
        <h2 class="m-0 text-h2">Join us</h2>
        <a
          href="/events"
          class="font-display font-semibold text-[15px] no-underline hover:underline"
        >
          All events →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <Card
          interactive
          href="/about#visit"
          eyebrow="1st & 3rd Sundays · 10am"
          title="Sunday worship"
        >
          Worship, readings and reflection at 2B Shirley Rd — everyone is
          welcome. Stay afterwards for refreshments and conversation.
          <Badge slot="footer" tone="gold">Morning tea after</Badge>
        </Card>
        <Card
          interactive
          href="https://swedenborg.com.au/"
          eyebrow="Tuesdays · 11am · Zoom"
          title="Open discussion"
        >
          Hosted by the Swedenborg Centre — delve deeper into the writings and
          relate them to our lives.
          <Badge slot="footer" tone="info">On Zoom</Badge>
        </Card>
        <Card
          interactive
          href="https://swedenborg.com.au/"
          eyebrow="Wednesdays · 10am · Zoom"
          title="Read & reflect"
        >
          Hosted by the Swedenborg Centre — reading slowly through one of the
          works, together.
          <Badge slot="footer" tone="info">On Zoom</Badge>
        </Card>
      </div>
    </section>

    <!-- Place — quiet exterior, not a hero -->
    <section class="container-site px-6 md:px-8 mt-14 md:mt-[72px]">
      <a
        href="/about#visit"
        class="group block overflow-hidden rounded-lg no-underline shadow-card bg-surface-card border border-border-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary transition-shadow duration-[280ms] ease-[var(--ease-gentle)] hover:shadow-lift"
      >
        <div class="relative aspect-[2/1] sm:aspect-[21/9] md:aspect-[3/1] overflow-hidden">
          <img
            src="/images/church/exterior.jpg"
            alt="Roseville New Church exterior on Shirley Road"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-[280ms] ease-[var(--ease-gentle)] group-hover:scale-[1.02]"
          />
        </div>
        <div class="px-5 py-4 sm:px-7 sm:py-5">
          <div
            class="font-display text-[12px] tracking-eyebrow uppercase text-accent-primary mb-1.5"
          >
            Our home
          </div>
          <div
            class="font-display font-semibold text-h3 tracking-display text-text-heading"
          >
            2B Shirley Rd, Roseville
          </div>
          <p class="m-0 mt-1 text-sm text-text-muted max-w-md">
            A short walk from Roseville station — join us on the 1st and 3rd
            Sundays at 10am.
          </p>
        </div>
      </a>
    </section>

    <!-- Quote band — from live homepage -->
    <section class="container-site px-6 md:px-8 mt-14 md:mt-[72px]">
      <div
        class="bg-gradient-dusk rounded-lg px-6 py-12 md:px-12 md:py-16 text-center text-text-on-dark"
      >
        <div class="text-gold-300 flex justify-center mb-3.5">
          <Sunrise size={28} stroke-width={1.5} aria-hidden="true" />
        </div>
        <p
          class="mx-auto max-w-[640px] italic text-[22px] md:text-[26px] leading-[1.5] m-0"
        >
          “All who live well, of whatever religion, have a place in heaven.”
        </p>
        <div
          class="mt-4 font-display text-[13px] tracking-eyebrow uppercase text-text-on-dark/60"
        >
          Emanuel Swedenborg · Divine Providence 330
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <section
      class="container-site px-6 md:px-8 pt-14 md:pt-[72px] pb-4 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 items-center"
      id="newsletter"
    >
      <div>
        <div
          class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-3"
        >
          Newsletter
        </div>
        <h2 class="mt-0 text-h2">News from the church</h2>
        <p class="text-text-muted">
          Reflections, garden updates, Swedenborg Centre news and what's coming
          up. Browse the archive, or leave your email when we open
          subscriptions.
        </p>
        <p class="mt-4">
          <a
            href="/newsletters"
            class="font-display font-semibold text-[15px] no-underline hover:underline"
          >
            Browse newsletters →
          </a>
        </p>
      </div>
      <Card variant="tint">
        <div id="newsletter-form" class="flex flex-col gap-3.5">
          <Input
            label="Email address"
            type="email"
            id="newsletter-email"
            name="email"
            placeholder="you@example.com"
            required
          />
          <Button type="button" id="newsletter-submit">Subscribe</Button>
        </div>
        <div
          id="newsletter-success"
          class="hidden font-display font-semibold text-lg text-status-success py-[18px]"
          role="status"
        >
          ✦ You're on the list — welcome!
        </div>
      </Card>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById('newsletter-form');
  const success = document.getElementById('newsletter-success');
  const submit = document.getElementById('newsletter-submit');
  const email = document.getElementById(
    'newsletter-email',
  ) as HTMLInputElement | null;

  submit?.addEventListener('click', () => {
    if (!email?.value?.trim()) {
      email?.focus();
      return;
    }
    form?.classList.add('hidden');
    success?.classList.remove('hidden');
  });
</script>
