---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import EventsCalendar from '../components/EventsCalendar.astro';

const icsUrl =
  import.meta.env.PUBLIC_CALENDAR_ICS_URL ||
  'https://outlook.office365.com/owa/calendar/d3aab09d67bf4025ae539869196ad552@rosevillenewchurch.com.au/e57651adf65b458bb5d1e3154770ba4517495040307124971130/calendar.ics';
---

<BaseLayout
  title="Roseville New Church"
  description="Welcome to the Roseville New Church — a community serving the Lord and encouraging personal development."
  currentPath="/"
>
  <main>
    <!-- Hero: dawn band + people photo as one responsive composition -->
    <section class="bg-gradient-dawn border-b border-border-soft overflow-hidden">
      <div
        class="container-site px-6 md:px-8 pt-10 sm:pt-12 md:pt-16 lg:pt-20 pb-10 sm:pb-12 md:pb-16 lg:pb-20"
      >
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-10 lg:gap-12 xl:gap-16 lg:items-center"
        >
          <div
            class="hero-copy lg:col-span-5 xl:col-span-5 text-center md:text-left flex flex-col items-center md:items-start"
          >
            <div
              class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-3 md:mb-4"
            >
              ✦ Roseville New Church
            </div>
            <h1
              class="m-0 font-light text-hero text-text-heading tracking-display"
            >
              Welcome
            </h1>
            <p
              class="mt-5 md:mt-6 mb-0 max-w-[34rem] text-lg text-text-body"
            >
              Welcome to the Roseville New Church, a community serving the Lord
              and encouraging personal development.
            </p>
            <p
              class="mt-3 md:mt-4 mb-0 max-w-[32rem] text-[15px] sm:text-base text-text-muted"
            >
              Step into a space where wisdom and compassion intersect, where
              seekers find a richer interpretation of the Bible, a deeper
              understanding of Christianity, and a precious sense of the Divine
              presence in the world. We’re here to help people grow closer to
              the Lord God Jesus Christ, and so find happiness, peace and
              meaning in their lives.
            </p>
            <div
              class="mt-7 md:mt-8 w-full sm:w-auto flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-center md:justify-start"
            >
              <Button size="lg" href="/events" class="w-full sm:w-auto"
                >What's on</Button
              >
              <Button
                size="lg"
                variant="secondary"
                href="/about"
                class="w-full sm:w-auto">About us</Button
              >
            </div>
          </div>

          <div class="hero-photo lg:col-span-7 xl:col-span-7 min-w-0">
            <figure
              class="relative overflow-hidden rounded-lg bg-violet-100 shadow-card aspect-[5/4] sm:aspect-[16/10] lg:aspect-[5/4] xl:aspect-[4/3]"
            >
              <img
                src="/images/people/julie-wayne-ros.jpg"
                alt="Members of the Roseville New Church community gathered together"
                decoding="async"
                fetchpriority="high"
                class="absolute inset-0 h-full w-full object-cover object-[center_28%] transition-transform duration-[600ms] ease-[var(--ease-gentle)] hover:scale-[1.02]"
              />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Visiting / events shortcuts -->
    <section class="container-site px-6 md:px-8 pt-14 md:pt-[72px]">
      <div
        class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 mb-6"
      >
        <h2 class="m-0 text-h2">Visiting us</h2>
        <a
          href="/events"
          class="font-display font-semibold text-[15px] no-underline hover:underline"
        >
          All events →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <Card
          interactive
          href="/events/sunday-worship"
          eyebrow="1st & 3rd Sundays · 10am"
          title="Sunday worship"
        >
          Worship, readings and reflection at 2B Shirley Rd — everyone is
          welcome. Stay afterwards for refreshments and conversation.
          <Badge slot="footer" tone="gold">Morning tea after</Badge>
        </Card>
        <Card
          interactive
          href="/events/open-discussion"
          eyebrow="Tuesdays · 11am · Zoom"
          title="Open discussion"
        >
          Hosted by the Swedenborg Centre — delve deeper into the writings and
          relate them to our lives.
          <Badge slot="footer" tone="info">On Zoom</Badge>
        </Card>
        <Card
          interactive
          href="/events/read-and-reflect"
          eyebrow="Wednesdays · 10am · Zoom"
          title="Read & reflect"
        >
          Hosted by the Swedenborg Centre — reading slowly through one of the
          works, together.
          <Badge slot="footer" tone="info">On Zoom</Badge>
        </Card>
      </div>
    </section>

    <!-- Live church calendar -->
    <section class="container-site px-6 md:px-8">
      <EventsCalendar icsUrl={icsUrl} />
      <p class="m-0 mt-2 mb-0 text-sm text-text-muted">
        See the{' '}
        <a href="/events" class="text-link hover:text-link-hover"
          >events page</a
        >{' '}
        for our regular weekly rhythm as well.
      </p>
    </section>

    <!-- Our home -->
    <section class="container-site px-6 md:px-8 mt-14 md:mt-[72px] pb-4">
      <a
        href="/events/sunday-worship"
        class="group block overflow-hidden rounded-lg no-underline shadow-card bg-surface-card border border-border-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary transition-shadow duration-[280ms] ease-[var(--ease-gentle)] hover:shadow-lift"
      >
        <div
          class="relative aspect-[2/1] sm:aspect-[21/9] md:aspect-[3/1] overflow-hidden"
        >
          <img
            src="/images/church/exterior.jpg"
            alt="Roseville New Church exterior on Shirley Road"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-[280ms] ease-[var(--ease-gentle)] group-hover:scale-[1.02]"
          />
        </div>
        <div class="px-5 py-4 sm:px-7 sm:py-5">
          <div
            class="font-display text-[12px] tracking-eyebrow uppercase text-accent-primary mb-1.5"
          >
            Our home
          </div>
          <div
            class="font-display font-semibold text-h3 tracking-display text-text-heading"
          >
            2B Shirley Rd, Roseville
          </div>
          <p class="m-0 mt-1 text-sm text-text-muted max-w-md">
            A short walk from Roseville station — join us on the 1st and 3rd
            Sundays at 10am. The Swedenborg Centre is next door at 4 Shirley Rd.
          </p>
        </div>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-copy {
    animation: hero-rise 700ms var(--ease-gentle) both;
  }

  .hero-photo {
    animation: hero-rise 900ms var(--ease-gentle) 120ms both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .hero-photo {
      animation: none;
    }
  }
</style>
