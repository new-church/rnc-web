---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import { getEvents, getInfos, whenLabel } from '../lib/events';

export const prerender = false;

// "Visiting us" comes from the church calendar: the featured event write-ups, each with its next date. Never fatal.
const calendarEvents = await getEvents().catch(() => []);
// Promoted: calendar entries with a "Pin to home page" line, soonest first, while they are still to come.
const pinned = calendarEvents
  .filter((e) => e.pinned && !e.cancelled && new Date(e.allDay ? `${e.end}T00:00:00Z` : e.end).getTime() >= Date.now())
  .slice(0, 3);
const featured = (await getInfos())
  .filter((i) => i.data.featured !== undefined)
  .sort((a, b) => a.data.featured! - b.data.featured!)
  .map((info) => ({
    info,
    next: calendarEvents.find((e) => e.info?.id === info.id && !e.cancelled),
  }));
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<BaseLayout
  title="Roseville New Church"
  description="A small, friendly Christian church on Shirley Road, Roseville. Sunday worship on the first and third Sundays at 10am, and everyone is welcome."
  currentPath="/"
>
  <main>
    <!-- Hero: dawn band + people photo as one responsive composition -->
    <section class="bg-gradient-dawn border-b border-border-soft overflow-hidden">
      <div
        class="container-site px-6 md:px-8 pt-10 sm:pt-12 md:pt-16 lg:pt-20 pb-10 sm:pb-12 md:pb-16 lg:pb-20"
      >
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-10 lg:gap-12 xl:gap-16 lg:items-center"
        >
          <div
            class="hero-copy lg:col-span-5 xl:col-span-5 text-center md:text-left flex flex-col items-center md:items-start"
          >
            <div
              class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-3 md:mb-4"
            >
              ✦ Roseville New Church
            </div>
            <h1
              class="m-0 font-light text-hero text-text-heading tracking-display"
            >
              Welcome
            </h1>
            <p
              class="mt-5 md:mt-6 mb-0 max-w-[34rem] text-lg text-text-body"
            >
              We’re a small, friendly Christian church on Shirley Road,
              Roseville: a place to worship, ask questions and think about what
              matters in life.
            </p>
            <p
              class="mt-3 md:mt-4 mb-0 max-w-[32rem] text-[15px] sm:text-base text-text-muted"
            >
              We follow Jesus Christ and look to the Bible for guidance in
              everyday life. For us, faith is about love and how we live. We meet on the first and third Sundays of the
              month at 10am, with tea and coffee afterwards.
            </p>
            <div
              class="mt-7 md:mt-8 w-full sm:w-auto flex flex-col sm:flex-row sm:flex-wrap gap-3 items-stretch sm:items-center justify-center md:justify-start"
            >
              <Button size="lg" href="/about/new-church" class="w-full sm:w-auto"
                >What is the New Church?</Button
              >
              <Button
                size="lg"
                variant="secondary"
                href="/events"
                class="w-full sm:w-auto">What's on</Button
              >
            </div>
          </div>

          <div class="hero-photo lg:col-span-7 xl:col-span-7 min-w-0">
            <figure
              class="relative overflow-hidden rounded-lg bg-violet-100 shadow-card aspect-[5/4] sm:aspect-[16/10] lg:aspect-[5/4] xl:aspect-[4/3]"
            >
              <img
                src="/images/people/julie-wayne-ros.jpg"
                alt="Members of the Roseville New Church community gathered together"
                decoding="async"
                fetchpriority="high"
                class="absolute inset-0 h-full w-full object-cover object-[center_28%] transition-transform duration-[600ms] ease-[var(--ease-gentle)] hover:scale-[1.02]"
              />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Promoted events: pinned in the church calendar (a "Pin to home page" line in the entry) -->
    {
      pinned.length > 0 && (
        <section class="container-site px-6 md:px-8 pt-12 md:pt-16" aria-label="Featured events">
          <div class="flex flex-col gap-6">
            {pinned.map((e) => {
              const extra = e.info?.data.buttons.find((b) => !b.secondary);
              return (
                <article class="group relative grid overflow-hidden rounded-2xl bg-gradient-dusk shadow-lift md:grid-cols-[5fr_6fr]">
                  {e.image && (
                    <div class="relative min-h-[220px] md:min-h-[300px]">
                      <img
                        src={e.image}
                        alt={e.imageAlt ?? ''}
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-[600ms] ease-[var(--ease-gentle)] group-hover:scale-[1.03]"
                      />
                    </div>
                  )}
                  <div class:list={['flex flex-col justify-center p-7 sm:p-9 md:p-11', !e.image && 'md:col-span-2']}>
                    <div class="font-display text-eyebrow font-semibold uppercase tracking-eyebrow text-gold-300">
                      ✦ {whenLabel(e)}
                    </div>
                    <h2 class="mt-3 mb-0 font-light text-h1 tracking-display text-text-on-dark">
                      <a href={e.href} class="text-inherit no-underline after:absolute after:inset-0 after:content-['']">
                        {e.displayTitle}
                      </a>
                    </h2>
                    <p class="mt-4 mb-0 max-w-[34rem] text-base leading-[1.65] text-text-on-dark/85">
                      {(e.note || e.info?.data.summary || '').split('\n\n')[0]}
                    </p>
                    <div class="relative z-10 mt-7 flex flex-wrap gap-3">
                      <Button variant="gold" href={e.href}>Find out more</Button>
                      {extra && (
                        <a
                          href={extra.href}
                          class="inline-flex items-center justify-center whitespace-nowrap rounded-pill border border-white/60 px-[22px] pt-[11px] pb-[9px] font-display text-[15px] font-semibold leading-none tracking-[0.04em] text-text-on-dark no-underline transition-colors duration-150 hover:bg-white/15"
                        >
                          {extra.label}
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      )
    }

    <!-- Visiting / events shortcuts -->
    <section class="container-site px-6 md:px-8 pt-14 md:pt-[72px]">
      <div
        class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 mb-6"
      >
        <h2 class="m-0 text-h2">Visiting us</h2>
        <a
          href="/events"
          class="font-display font-semibold text-[15px] no-underline hover:underline"
        >
          All events →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {
          featured.map(({ info, next }) => (
            <Card
              interactive
              href={info.data.page ?? `/events/${info.id}`}
              eyebrow={next ? `Next: ${whenLabel(next)}` : 'See upcoming dates'}
              title={info.data.shortTitle ?? info.data.title}
            >
              {info.data.summary}
              <Badge slot="footer" tone={info.data.where === 'In person' ? 'gold' : 'info'}>
                {info.data.where === 'In person' ? 'Morning tea after' : info.data.where}
              </Badge>
            </Card>
          ))
        }
      </div>
    </section>


    <!-- Our home -->
    <section class="container-site px-6 md:px-8 mt-14 md:mt-[72px] pb-4">
      <a
        href="/events/sunday-worship"
        class="group block overflow-hidden rounded-lg no-underline shadow-card bg-surface-card border border-border-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-primary transition-shadow duration-[280ms] ease-[var(--ease-gentle)] hover:shadow-lift"
      >
        <div
          class="relative aspect-[2/1] overflow-hidden"
        >
          <img
            src="/images/church/exterior.jpg"
            alt="Roseville New Church exterior on Shirley Road"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-[50%_37%] transition-transform duration-[280ms] ease-[var(--ease-gentle)] group-hover:scale-[1.02]"
          />
        </div>
        <div class="px-5 py-4 sm:px-7 sm:py-5">
          <div
            class="font-display text-[12px] tracking-eyebrow uppercase text-accent-primary mb-1.5"
          >
            Our home
          </div>
          <div
            class="font-display font-semibold text-h3 tracking-display text-text-heading"
          >
            2B Shirley Rd, Roseville
          </div>
          <p class="m-0 mt-1 text-sm text-text-muted max-w-md">
            A short walk from Roseville station — join us on the 1st and 3rd
            Sundays at 10am.
          </p>
        </div>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-copy {
    animation: hero-rise 700ms var(--ease-gentle) both;
  }

  .hero-photo {
    animation: hero-rise 900ms var(--ease-gentle) 120ms both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .hero-photo {
      animation: none;
    }
  }
</style>
