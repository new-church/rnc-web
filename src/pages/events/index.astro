---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tabs from '../../components/Tabs.astro';
import Card from '../../components/Card.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import EventsCalendar from '../../components/EventsCalendar.astro';

const icsUrl =
  import.meta.env.PUBLIC_CALENDAR_ICS_URL ||
  'https://outlook.office365.com/owa/calendar/d3aab09d67bf4025ae539869196ad552@rosevillenewchurch.com.au/e57651adf65b458bb5d1e3154770ba4517495040307124971130/calendar.ics';

const events = [
  {
    title: 'Sunday worship',
    date: '1st & 3rd Sundays · 10am',
    category: 'Worship',
    where: 'In person' as const,
    href: '/events/sunday-worship',
    desc: 'Worship, readings and reflection at 2B Shirley Rd, followed by refreshments and conversation in the hall. A service pamphlet with hymns is provided.',
  },
  {
    title: 'Swedenborg Tuesday: open discussion',
    date: 'Tuesdays · 11am',
    category: 'Study',
    where: 'On Zoom' as const,
    href: '/events/open-discussion',
    desc: "Hosted by the Swedenborg Centre — delve a little deeper into concepts in Swedenborg's writing and relate them to our lives.",
  },
  {
    title: "Read and reflect on Swedenborg's writings",
    date: 'Wednesdays · 10am',
    category: 'Study',
    where: 'On Zoom' as const,
    href: '/events/read-and-reflect',
    desc: 'Hosted by the Swedenborg Centre — reading slowly through True Christianity, reflecting as we go.',
  },
  {
    title: 'Monday meditation',
    date: 'Mondays · 10am',
    category: 'Community',
    where: 'In person' as const,
    href: '/events/meditation',
    desc: 'Quiet meditation in the church sanctuary with Kathryn Baker. Please confirm with Kathryn before your first visit.',
  },
  {
    title: 'New Church Family Retreat 2027',
    date: '22–26 January 2027',
    category: 'Community',
    where: 'In person' as const,
    href: '/events/family-retreat-2027',
    desc: 'Five days at The Tops Conference Centre, Stanwell Tops — worship, talks, activities and fellowship for all ages.',
  },
  {
    title: 'Church garden working bee',
    date: 'As announced',
    category: 'Community',
    where: 'In person' as const,
    desc: 'Help us care for the church garden — tools and morning tea provided. Dates are shared in the newsletter.',
  },
];

const tabs = ['All', 'Worship', 'Study', 'Community'];
---

<BaseLayout
  title="Events"
  description="Worship, study and community at Roseville New Church — 1st and 3rd Sundays at 10am."
  currentPath="/events"
>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-16">
    <div
      class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5"
    >
      ✦ What's on
    </div>
    <h1 class="mt-0 text-h1">Upcoming events</h1>
    <p class="text-text-muted -mt-1.5 max-w-[640px]">
      Sunday worship is on the <strong>1st and 3rd Sundays</strong> of each month
      at 10am (Sydney time). Browse dated events on the calendar, or the regular
      rhythm below — each item links through to full details.
    </p>

    <EventsCalendar icsUrl={icsUrl} />

    <h2 class="mt-14 mb-2 text-h2">Regular rhythm</h2>
    <p class="text-text-muted mt-0 mb-5 max-w-[640px]">
      Midweek Zoom groups are run by the{' '}
      <a
        href="https://swedenborg.com.au/"
        rel="noopener noreferrer"
        target="_blank">Swedenborg Centre</a
      > — check their site for the latest links and times.
    </p>

    <Tabs tabs={tabs} active="All" class="my-[18px] mb-[26px]" />

    <div class="flex flex-col gap-4 max-w-[760px]">
      {
        events.map((event) => (
          <div data-category={event.category}>
            <Card eyebrow={event.date} title={event.title}>
              {event.desc}
              <div slot="footer" class="flex flex-wrap gap-2.5 items-center">
                <Badge tone={event.where === 'On Zoom' ? 'info' : 'success'}>
                  {event.where}
                </Badge>
                {event.href && (
                  <Button size="sm" variant="secondary" href={event.href}>
                    Learn more
                  </Button>
                )}
              </div>
            </Card>
          </div>
        ))
      }
    </div>
  </main>
</BaseLayout>
