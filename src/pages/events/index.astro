---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tabs from '../../components/Tabs.astro';
import EventCard from '../../components/EventCard.astro';
import EventsCalendar from '../../components/EventsCalendar.astro';
import { getEvents, icsUrl, whenLabel } from '../../lib/events';

export const prerender = false;

// The Outlook calendar is the single source of truth: it is read on the server (cached five minutes, see lib/ics.ts)
// and the page is cached at the edge too. Write-ups come from src/content/event-info, matched by calendar title.
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

// Only what is still to come: anything that has already finished is left out (of the list and the calendar).
const upcoming = (await getEvents()).filter((e) => new Date(e.allDay ? `${e.end}T00:00:00Z` : e.end).getTime() >= Date.now());
// Pinned events (a "Pin to home page" line in the calendar entry) lead the list, in a darker card.
const isPinned = (e: (typeof upcoming)[number]) => e.pinned && !e.cancelled;
const ordered = [...upcoming.filter(isPinned), ...upcoming.filter((e) => !isPinned(e))];
const calendarEvents = upcoming.map((e) => ({
  uid: e.uid,
  title: e.displayTitle,
  description: e.summary,
  location: e.location,
  start: e.start,
  end: e.end,
  allDay: e.allDay,
  cancelled: e.cancelled,
  href: e.href,
}));
const tabs = ['All', 'Worship', 'Study', 'Community'];
---

<BaseLayout
  title="Events"
  description="Worship, study and community at Roseville New Church — 1st and 3rd Sundays at 10am."
  currentPath="/events"
>
  <main class="container-site px-6 md:px-8 pt-10 md:pt-14 pb-16">
    <div
      class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5"
    >
      ✦ What's on
    </div>
    <h1 class="mt-0 text-h1">Upcoming events</h1>
    <p class="text-text-muted -mt-1.5 max-w-[640px]">
      Sunday worship is on the <strong>1st and 3rd Sundays</strong> of each month
      at 10am (Sydney time). Everything here comes straight from the church
      calendar, and each event links through to full details. The midweek Zoom
      groups are run by the{' '}
      <a
        href="https://swedenborg.com.au/"
        rel="noopener noreferrer"
        target="_blank">Swedenborg Centre</a
      >.
    </p>

    <div class="mt-10 grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_380px] lg:items-start">
      <div>
        <Tabs tabs={tabs} active="All" class="mb-6" />

        {upcoming.length === 0 && (
          <p class="text-text-muted">No upcoming events are listed right now. Please check back soon.</p>
        )}
        <div class="flex flex-col gap-4">
          {
            ordered.slice(0, 30).map((event) => (
              <div data-category={event.category}>
                <EventCard
                  href={event.href}
                  eyebrow={whenLabel(event)}
                  title={event.displayTitle}
                  text={event.cancelled ? (event.note || 'This event has been cancelled.') : (event.note || event.info?.data.summary || '')}
                  image={event.image}
                  imageAlt={event.imageAlt}
                  cancelled={event.cancelled}
                  featured={isPinned(event)}
                  badges={[{ label: event.where, tone: event.where === 'In person' ? 'success' : 'info' }]}
                />
              </div>
            ))
          }
          <div data-category="Community">
            <EventCard
              href="/contact"
              eyebrow="Ongoing · online"
              title="Prayer circle"
              text="Our online community on WhatsApp includes a prayer circle, a way of holding one another in prayer between services. Get in touch and we will send you an invitation."
              badges={[{ label: 'Online', tone: 'info' }]}
            />
          </div>
        </div>
      </div>

      <aside class="order-first lg:order-none lg:sticky lg:top-24" aria-label="Calendar">
        <EventsCalendar icsUrl={icsUrl} events={calendarEvents} failed={upcoming.length === 0} />
      </aside>
    </div>
  </main>
</BaseLayout>
