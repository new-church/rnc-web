---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import UpcomingDates from '../../components/UpcomingDates.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { getEvents, whenLabel, rangeLabel, finishedAt } from '../../lib/events';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

const slug = Astro.params.slug ?? '';

// Two kinds of address share this route:
//   /events/meditation                 the series page, from src/content/event-info/meditation.md
//   /events/202612061000-advent-service  one dated calendar entry (for events with no write-up)
const infos = await getCollection('event-info');
const info = infos.find((i) => i.id === slug && !i.data.page);

const photos = await getCollection('gallery');

let Content;
let upcoming = [];
let occurrence;
// One-off events: the dates this page is about (next one first), and whether they are all over.
let dates: Awaited<ReturnType<typeof getEvents>> = [];
let finished = false;
if (info) {
  Content = (await render(info)).Content;
  if (info.data.oneOff) {
    const mine = (await getEvents({ since: new Date(Date.now() - 40 * 86400_000) })).filter((e) => e.info?.id === info.id);
    const live = mine.filter((e) => finishedAt(e) >= Date.now());
    finished = live.length === 0;
    dates = finished ? mine.slice(-1) : live;
  } else {
    upcoming = (await getEvents()).filter((e) => e.info?.id === info.id);
  }
} else {
  const all = await getEvents({ since: new Date(Date.now() - 40 * 86400_000) });
  occurrence = all.find((e) => e.slug === slug);
  if (!occurrence) return Astro.redirect('/events', 302);
}

const title = info ? info.data.title : occurrence!.displayTitle;
const description = info ? info.data.summary : occurrence!.description.slice(0, 160);
---

<BaseLayout title={title} description={description} currentPath="/events">
  <main class="container-prose px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <p class="mb-4">
      <a
        href="/events"
        class="font-display text-sm font-semibold text-accent-primary no-underline hover:underline"
        >← Events</a
      >
    </p>

    {
      info ? (
        <>
          <article class="prose-rnc">
            <div class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5 !mt-0">
              ✦ {info.data.oneOff && dates.length > 0 ? (finished ? 'Finished' : whenLabel(dates[0])) : (info.data.where ?? 'In person')}
            </div>
            <h1>{info.data.title}</h1>
            {info.data.oneOff && (
              <div class="not-prose my-6 rounded-xl border border-border-soft bg-surface-card px-5 py-4">
                {finished ? (
                  <p class="m-0 text-text-muted">
                    This event has finished. See the <a href="/events">events page</a> for what is on next.
                  </p>
                ) : dates.length > 0 ? (
                  <dl class="m-0 grid grid-cols-[4.5rem_1fr] items-baseline gap-x-4 gap-y-3 sm:grid-cols-[5.5rem_1fr]">
                    <dt class="m-0 font-display text-[13px] font-semibold uppercase tracking-[0.12em] text-accent-primary">
                      {dates.length > 1 ? 'Dates' : 'When'}
                    </dt>
                    <dd class="m-0 font-display text-lg font-semibold leading-snug text-text-heading">
                      {dates.length > 1 ? (
                        <ul class="m-0 p-0 list-none">
                          {dates.map((d) => (
                            <li class:list={[d.cancelled && 'line-through text-status-error']}>
                              {rangeLabel(d)}
                              {d.cancelled && ' (cancelled)'}
                            </li>
                          ))}
                        </ul>
                      ) : (
                        <span class:list={[dates[0].cancelled && 'line-through text-status-error']}>
                          {rangeLabel(dates[0])}
                          {dates[0].cancelled && ' (cancelled)'}
                        </span>
                      )}
                    </dd>
                    <dt class="m-0 font-display text-[13px] font-semibold uppercase tracking-[0.12em] text-accent-primary">Where</dt>
                    <dd class="m-0 font-display text-lg font-semibold leading-snug text-text-heading">
                      {dates[0].location || (info.data.where === 'In person' || !info.data.where ? 'In person' : info.data.where)}
                    </dd>
                  </dl>
                ) : (
                  <p class="m-0 text-text-muted">
                    The date and time will be confirmed soon. Please <a href="/contact">get in touch</a> if you have any questions.
                  </p>
                )}
                {!finished && (info.data.buttons.length > 0 || info.data.zoomlink) && (
                  <div class="mt-5 flex flex-wrap gap-3 border-t border-border-soft pt-5">
                    {info.data.zoomlink && <Button href={info.data.zoomlink}>Join on Zoom</Button>}
                    {info.data.buttons.map((b) => (
                      <Button variant={b.secondary ? 'secondary' : 'primary'} href={b.href}>
                        {b.label}
                      </Button>
                    ))}
                  </div>
                )}
              </div>
            )}
            {info.data.oneOff && info.data.image && (
              <figure class="not-prose mt-0 mb-8">
                <img
                  src={info.data.image}
                  alt={info.data.imageAlt ?? ''}
                  decoding="async"
                  style={`object-position: ${info.data.imagePosition ?? 'center'}`}
                  class="block aspect-[16/9] w-full rounded-xl object-cover shadow-card"
                />
              </figure>
            )}
            <Content />
          </article>
          {!info.data.oneOff && info.data.image && (
            <figure class="mt-8 mb-0">
              <img
                src={info.data.image}
                alt={info.data.imageAlt ?? ''}
                loading="lazy"
                class="block max-h-[420px] w-auto max-w-full rounded-lg shadow-card"
              />
            </figure>
          )}
          {!info.data.oneOff && (info.data.buttons.length > 0 || info.data.zoomlink) && (
            <div class="mt-8 flex flex-wrap gap-3">
              {info.data.zoomlink && <Button href={info.data.zoomlink}>Join on Zoom</Button>}
              {info.data.buttons.map((b) => (
                <Button variant={b.secondary ? 'secondary' : 'primary'} href={b.href}>
                  {b.label}
                </Button>
              ))}
            </div>
          )}
          <PhotoGallery
            title="Photos"
            photos={info.data.gallery
              .map((id) => photos.find((p) => p.id === id))
              .filter((p) => p !== undefined)
              .map((p) => ({ id: p.id, ...p.data }))}
          />
          {!info.data.oneOff && <UpcomingDates events={upcoming} title="Coming up" limit={8} />}
        </>
      ) : (
        <article class="prose-rnc">
          {occurrence!.cancelled && (
            <div class="not-prose mb-6 rounded-lg border border-status-error/40 bg-status-error-bg px-5 py-4" role="status">
              <Badge tone="error">Cancelled</Badge>
              <p class="m-0 mt-2 text-status-error">
                This event has been cancelled. Please check the{' '}
                <a href="/events">events page</a> for what is on next.
              </p>
            </div>
          )}
          <div
            class:list={[
              'font-display font-semibold text-eyebrow tracking-eyebrow uppercase mb-2.5 !mt-0',
              occurrence!.cancelled ? 'text-status-error line-through' : 'text-accent-primary',
            ]}
          >
            ✦ {whenLabel(occurrence!)}
          </div>
          <h1>{occurrence!.displayTitle}</h1>
          {occurrence!.location && <p><strong>{occurrence!.location}</strong></p>}
          {occurrence!.description
            ? occurrence!.description.split(/\n{2,}/).map((p) => <p class="whitespace-pre-line">{p}</p>)
            : <p>More details will be added soon. Please <a href="/contact">get in touch</a> if you have any questions.</p>}
        </article>
      )
    }
  </main>
</BaseLayout>
