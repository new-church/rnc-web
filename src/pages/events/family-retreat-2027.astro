---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import SoftPhoto from '../../components/SoftPhoto.astro';
import Badge from '../../components/Badge.astro';
---

<BaseLayout
  title="Family retreat 2027"
  description="New Church in Australia Family Retreat — 22–26 January 2027 at The Tops Conference Centre, Stanwell Tops."
  currentPath="/events"
>
  <main class="container-prose px-6 md:px-8 pt-10 md:pt-14 pb-4">
    <p class="mb-4">
      <a
        href="/events"
        class="font-display text-sm font-semibold text-accent-primary no-underline hover:underline"
        >← Events</a
      >
    </p>

    <article class="prose-rnc">
      <div
        class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5 !mt-0"
      >
        ✦ 22–26 January 2027
      </div>
      <h1>New Church in Australia Family Retreat</h1>
      <p>
        The Tops Conference Centre, 51 Bendena Gardens, Stanwell Tops, NSW
      </p>
      <p>
        You're warmly invited to join us for the 2027 New Church in Australia
        Family Retreat.
      </p>
      <p>
        Whether you're coming for the first time or returning to reconnect with
        old friends, the retreat offers a welcoming space to step away from the
        busyness of everyday life, deepen your spiritual life, and enjoy the
        company of people of all ages.
      </p>
      <p>
        Over five days you'll find a relaxed blend of inspiring talks and
        discussions, worship, creative and recreational activities, shared
        meals, and plenty of opportunities for conversation, laughter, and quiet
        reflection. Families, couples, singles, and people who are simply
        interested in exploring spirituality are all welcome.
      </p>
      <p>
        You are welcome to stay for the entire retreat or, if you are unable to
        do so, visit as a day guest.
      </p>
      <p>
        We hope you'll join us for a time of spiritual refreshment, meaningful
        friendships, and the simple joy of sharing life together in a beautiful
        natural setting.
      </p>
    </article>

    <div class="mt-8">
      <SoftPhoto
        src="/images/join/retreat.png"
        alt="New Church family retreat gathering"
        aspect="aspect-[16/10]"
      />
    </div>

    <div class="mt-8 flex flex-col gap-4">
      <h2 class="text-h2 m-0">Plan your visit</h2>
      <p class="text-text-muted m-0">
        Booking details will be published here when they are confirmed.
      </p>
      <Card title="Retreat information">
        <Badge tone="violet">Placeholder</Badge>
        <p class="mt-3 mb-0 text-sm text-text-muted">
          Venue, accommodation and costs — including a booking form link — to be
          added.
        </p>
      </Card>
      <Card title="Online booking form">
        <Badge tone="violet">Placeholder</Badge>
        <p class="mt-3 mb-0 text-sm text-text-muted">
          Register your interest and book your place — link coming soon.
        </p>
      </Card>
      <Card title="Day visitor information">
        <Badge tone="violet">Placeholder</Badge>
        <p class="mt-3 mb-0 text-sm text-text-muted">
          For those planning to attend for a single day — details coming soon.
        </p>
      </Card>
    </div>

    <div class="mt-8">
      <Button variant="secondary" href="/contact">Ask the church office</Button>
    </div>
  </main>
</BaseLayout>
