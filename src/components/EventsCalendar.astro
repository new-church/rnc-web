---
type CalendarEvent = {
  uid: string;
  title: string;
  description: string;
  location: string;
  start: string;
  end: string;
  allDay: boolean;
  cancelled: boolean;
  /** The event's own page. */
  href?: string;
  image?: string;
};

interface Props {
  icsUrl: string;
  events: CalendarEvent[];
  /** The calendar could not be read on the server. */
  failed?: boolean;
  class?: string;
}

const { icsUrl, events, failed = false, class: className = '' } = Astro.props;
const webcalUrl = icsUrl.replace(/^https:/i, 'webcal:');
// Embedded as JSON so the browser never has to fetch the calendar itself. "<" is escaped so the data can't end the tag.
const eventsJson = JSON.stringify(events).replace(/</g, '\\u003c');
---

<section
  class:list={['rounded-2xl border border-border-soft bg-surface-card/80 p-4 sm:p-5 shadow-[0_1px_0_rgba(46,26,71,0.04)]', className]}
  data-events-calendar
  aria-label="Events calendar"
>
  <div class="flex items-center justify-between gap-3 mb-3">
    <button
      type="button"
      data-prev
      class="font-display font-semibold text-[14px] text-accent-primary-strong px-3 py-2 rounded-lg hover:bg-violet-50 transition-colors"
      aria-label="Previous month"
    >
      ←
    </button>
    <h2
      data-month-label
      class="m-0 font-display font-semibold text-[17px] text-text-heading tracking-wide"
    >
      …
    </h2>
    <button
      type="button"
      data-next
      class="font-display font-semibold text-[14px] text-accent-primary-strong px-3 py-2 rounded-lg hover:bg-violet-50 transition-colors"
      aria-label="Next month"
    >
      →
    </button>
  </div>

  <div class="relative">
    <div
      class="pointer-events-none absolute inset-0 grid grid-cols-7 gap-0.5"
      aria-hidden="true"
    >
      <div></div><div></div><div></div><div></div><div></div>
      <div class="bg-stone-100/90 rounded-sm"></div>
      <div class="bg-stone-100/90 rounded-sm"></div>
    </div>

    <div
      class="relative grid grid-cols-7 gap-0.5 mb-1 text-center font-display text-[10px] font-semibold tracking-[0.12em] uppercase text-text-muted"
      aria-hidden="true"
    >
      <span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span class="text-stone-500">Sa</span><span class="text-stone-500">Su</span>
    </div>

    <div data-grid class="relative grid grid-cols-7 gap-0.5" role="grid"></div>
  </div>

  <p data-status class="m-0 mt-3 text-sm text-text-muted" aria-live="polite">
    {failed ? 'Could not load the live calendar. You can still subscribe below.' : ''}
  </p>
  <ul data-list class="m-0 mt-2 p-0 list-none flex flex-col gap-2.5"></ul>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-border-soft pt-3">
    <span class="text-[12px] text-text-muted">Cancelled events show in red.</span>
    <a
      data-subscribe
      href={webcalUrl}
      class="font-display text-[13px] font-semibold text-accent-primary no-underline hover:underline"
    >
      Add to my calendar
    </a>
  </div>

  <script
    is:inline
    type="application/json"
    data-events-json
    set:html={eventsJson}
  />
</section>

<script>
  type CalendarEvent = {
    uid: string;
    title: string;
    description: string;
    location: string;
    start: string;
    end: string;
    allDay: boolean;
    cancelled: boolean;
    href?: string;
    image?: string;
  };

  const root = document.querySelector<HTMLElement>('[data-events-calendar]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const monthLabel = root.querySelector<HTMLElement>('[data-month-label]')!;
    const tz = 'Australia/Sydney';

    // Set by the server when the calendar could not be read.
    const serverMessage = status.textContent?.trim() ?? '';
    let events: CalendarEvent[] = [];
    try {
      events = JSON.parse(root.querySelector('[data-events-json]')?.textContent || '[]');
    } catch {
      events = [];
    }

    const ymdInTz = (iso: string, allDay: boolean) => {
      if (allDay && /^\d{4}-\d{2}-\d{2}$/.test(iso)) return iso;
      return new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(iso));
    };
    const shiftYmd = (ymd: string, days: number) => {
      const [y, m, d] = ymd.split('-').map(Number);
      return new Date(Date.UTC(y!, m! - 1, d! + days)).toISOString().slice(0, 10);
    };
    /** All-day DTEND is exclusive; this is the inclusive last day. */
    const lastDay = (e: CalendarEvent) => {
      const start = ymdInTz(e.start, true);
      const endExclusive = ymdInTz(e.end || e.start, true);
      return endExclusive <= start ? start : shiftYmd(endExclusive, -1);
    };
    const spans = (e: CalendarEvent, key: string) =>
      e.allDay ? key >= ymdInTz(e.start, true) && key <= lastDay(e) : ymdInTz(e.start, false) === key;
    const eventsForDay = (key: string) => events.filter((e) => spans(e, key));

    const clock = (iso: string) =>
      new Intl.DateTimeFormat('en-AU', { timeZone: tz, hour: 'numeric', minute: '2-digit' })
        .format(new Date(iso))
        .replace(':00', '')
        .replace(/\s/g, '')
        .toLowerCase();
    const dayHeading = (key: string) => {
      const [y, m, d] = key.split('-').map(Number);
      return new Intl.DateTimeFormat('en-AU', { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(y!, m! - 1, d!));
    };
    const escapeHtml = (s: string) =>
      s.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');

    let cursor = new Date();
    cursor = new Date(cursor.getFullYear(), cursor.getMonth(), 1);
    let selectedKey: string | null = null;

    const eventsInMonth = (y: number, m: number) => {
      const prefix = `${y}-${String(m + 1).padStart(2, '0')}`;
      const days = new Date(y, m + 1, 0).getDate();
      return events.filter((e) => {
        for (let d = 1; d <= days; d++) if (spans(e, `${prefix}-${String(d).padStart(2, '0')}`)) return true;
        return false;
      });
    };

    const renderList = () => {
      list.innerHTML = '';
      const y = cursor.getFullYear();
      const m = cursor.getMonth();
      if (serverMessage && !events.length) {
        status.textContent = serverMessage;
        return;
      }
      if (!selectedKey) {
        const n = eventsInMonth(y, m).length;
        status.textContent = n
          ? `${n} event${n === 1 ? '' : 's'} this month. Pick a day to see what's on.`
          : 'Nothing coming up this month.';
        return;
      }
      const shown = eventsForDay(selectedKey);
      status.textContent = shown.length ? dayHeading(selectedKey) : `Nothing on ${dayHeading(selectedKey)}.`;
      for (const e of shown) {
        const li = document.createElement('li');
        li.className = `rounded-xl border px-3.5 py-3 ${e.cancelled ? 'border-status-error/40 bg-status-error-bg/60' : 'border-border-soft bg-surface-page'}`;
        const when = e.allDay ? 'All day' : clock(e.start);
        const name = e.href
          ? `<a href="${escapeHtml(e.href)}" class="text-text-heading no-underline hover:text-link-hover">${escapeHtml(e.title)}</a>`
          : escapeHtml(e.title);
        li.innerHTML = `
          <div class="font-display text-[11px] font-semibold tracking-[0.12em] uppercase ${e.cancelled ? 'text-status-error line-through' : 'text-accent-primary'}">${when}</div>
          <div class="font-display font-semibold text-[15px] text-text-heading ${e.cancelled ? 'line-through decoration-status-error/60' : ''}">${name}</div>
          ${e.description ? `<p class="mt-1 mb-0 text-[13px] text-text-body">${escapeHtml(e.description.split('\n\n')[0]!)}</p>` : ''}`;
        list.appendChild(li);
      }
    };
    const renderGrid = () => {
      const y = cursor.getFullYear();
      const m = cursor.getMonth();
      monthLabel.textContent = new Intl.DateTimeFormat('en-AU', { month: 'long', year: 'numeric' }).format(cursor);
      const firstDow = (new Date(y, m, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(y, m + 1, 0).getDate();
      const todayKey = ymdInTz(new Date().toISOString(), false);

      grid.innerHTML = '';
      for (let i = 0; i < firstDow; i++) grid.appendChild(document.createElement('div'));

      for (let day = 1; day <= daysInMonth; day++) {
        const key = `${y}-${String(m + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const dayEvents = eventsForDay(key);
        const isSelected = selectedKey === key;
        const isToday = todayKey === key;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'gridcell');
        btn.dataset.day = key;
        btn.className = [
          'flex min-h-[3rem] flex-col items-center gap-1 rounded-md border pt-1.5 pb-1 font-display text-[13px] font-semibold transition-colors duration-150',
          isSelected
            ? 'bg-violet-700 text-text-on-dark border-violet-700'
            : isToday
              ? 'bg-violet-50 border-violet-200 text-text-heading'
              : 'bg-transparent border-transparent text-text-heading hover:bg-black/[0.04]',
        ].join(' ');
        const dots = dayEvents
          .slice(0, 3)
          .map((e) => {
            const tone = e.cancelled ? 'bg-status-error' : isSelected ? 'bg-gold-300' : 'bg-violet-500';
            return `<span class="block h-1.5 w-1.5 rounded-full ${tone}"></span>`;
          })
          .join('');
        btn.innerHTML = `<span class="leading-none">${day}</span><span class="flex h-1.5 gap-0.5">${dots}</span>`;
        btn.setAttribute(
          'aria-label',
          dayEvents.length
            ? `${dayHeading(key)}, ${dayEvents.length} event${dayEvents.length === 1 ? '' : 's'}: ${dayEvents.map((e) => (e.cancelled ? 'cancelled ' : '') + e.title).join(', ')}`
            : dayHeading(key),
        );
        btn.addEventListener('click', () => {
          selectedKey = selectedKey === key ? null : key;
          renderGrid();
        });
        grid.appendChild(btn);
      }
      renderList();
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1);
      selectedKey = null;
      renderGrid();
    });
    root.querySelector('[data-next]')?.addEventListener('click', () => {
      cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1);
      selectedKey = null;
      renderGrid();
    });

    renderGrid();
  }
</script>
