---
interface Props {
  src: string;
  alt: string;
  class?: string;
  /** Tailwind aspect class, e.g. aspect-[16/10] */
  aspect?: string;
}

const {
  src,
  alt,
  class: className = '',
  aspect = 'aspect-[16/10]',
} = Astro.props;
---

<figure
  class:list={[
    'relative overflow-hidden rounded-lg bg-violet-100 shadow-card',
    aspect,
    className,
  ]}
>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
  />
</figure>
