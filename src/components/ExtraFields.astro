---
/**
 * The optional "more details" fields shared by the signup form and the details page. The server reads them with
 * parseExtra() in lib/members/validate.ts, so the names here must match.
 *
 * Phone: a country dropdown (Australia first) and the number; the server turns them into what Planning Center wants.
 * Address: when address search is available, people search and pick an address and the fields fill in locked; "Edit
 * manually" unlocks them. Without it (no key) the fields are plain inputs.
 */
import Input from './Input.astro';
import Select from './Select.astro';
import { countryOptions } from '../lib/phone';
import { addressLookupAvailable } from '../lib/address';
import { turnstileKeys } from '../lib/signup';
import type { Address } from '../lib/members/people';

interface Props {
  birthdate?: string;
  /** Shown under the date of birth, e.g. when we only know the day and month */
  birthdateHint?: string;
  phone?: string;
  phoneCountry?: string;
  address?: Address | null;
  idPrefix?: string;
}

const { birthdate = '', birthdateHint = '', phone = '', phoneCountry = 'AU', address = null, idPrefix = 'x' } = Astro.props;
const a = address ?? { street1: '', street2: '', city: '', state: '', zip: '', country: 'AU' };
const country = a.country || 'AU';
const siteKey = turnstileKeys()?.siteKey ?? '';
// Address search needs the robot check, so without Turnstile keys (a misconfigured production) it stays off.
const lookup = addressLookupAvailable() && Boolean(siteKey);
const hasAddress = Boolean(a.street1 || a.city || a.zip);
const { priority, rest } = countryOptions();

const field = 'font-body text-base text-text-body px-4 py-3 rounded-md border border-border-strong bg-white outline-none transition-[box-shadow,border-color] duration-150 focus:border-accent-primary focus:shadow-glow w-full';
const label = 'flex flex-col gap-1.5 font-display text-sm text-text-heading';
---

<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-2">
    <Input label="Date of birth" id={`${idPrefix}-birthdate`} name="birthdate" type="date" value={birthdate} autocomplete="bday" />
    {birthdateHint && (
      <p class="m-0 rounded-md border border-border-soft bg-surface-tint px-3 py-2 text-[13px] text-text-body" id={`${idPrefix}-birthdate-hint`}>{birthdateHint}</p>
    )}
  </div>

  <div class={label}>
    <label for={`${idPrefix}-phone`}>Phone</label>
    <div class="grid grid-cols-[minmax(0,9.5rem)_1fr] gap-3">
      <Select name="phoneCountry" ariaLabel="Phone country" autocomplete="off">
        {priority.map((c) => <option value={c.iso} selected={c.iso === phoneCountry}>{c.iso} {c.callingCode}</option>)}
        <option disabled>──────────</option>
        {rest.map((c) => <option value={c.iso} selected={c.iso === phoneCountry}>{c.name} {c.callingCode}</option>)}
      </Select>
      <input id={`${idPrefix}-phone`} name="phone" type="tel" value={phone} autocomplete="tel-national" placeholder="0412 345 678" class={field} />
    </div>
  </div>

  <fieldset class="border-0 p-0 m-0 flex flex-col gap-3" data-address data-lookup={lookup ? '1' : '0'} data-has={hasAddress ? '1' : '0'} data-sitekey={siteKey}>
    <legend class="font-display text-sm text-text-heading mb-1">Postal address</legend>

    {lookup && (
      <div class="relative">
        <label class={label}>
          Find your address
          <input type="search" data-address-search autocomplete="off" placeholder="Start typing your street address…" role="combobox" aria-expanded="false" aria-controls={`${idPrefix}-addr-list`} class={field} />
        </label>
        <ul id={`${idPrefix}-addr-list`} data-address-list role="listbox" hidden class="absolute z-20 left-0 right-0 mt-1 max-h-64 overflow-auto rounded-md border border-border-soft bg-white py-1 shadow-md list-none m-0 p-0"></ul>
        <p data-address-status class="m-0 mt-1 text-[13px] text-text-muted" role="status"></p>
      </div>
    )}

    <div data-address-fields class="flex flex-col gap-3" hidden={lookup && !hasAddress}>
      <label class={label}>Street<input name="street1" value={a.street1} autocomplete="address-line1" class={field} /></label>
      <label class={label}>Street (second line)<input name="street2" value={a.street2} autocomplete="address-line2" class={field} /></label>
      <div class="grid grid-cols-1 sm:grid-cols-[1fr_7rem_7rem] gap-3">
        <label class={label}>Suburb or town<input name="city" value={a.city} autocomplete="address-level2" class={field} /></label>
        <label class={label}>State<input name="state" value={a.state} autocomplete="address-level1" class={field} /></label>
        <label class={label}>Postcode<input name="zip" value={a.zip} autocomplete="postal-code" class={field} /></label>
      </div>
      <Select label="Country" name="country" autocomplete="country">
        {priority.map((c) => <option value={c.iso} selected={c.iso === country}>{c.name}</option>)}
        <option disabled>──────────</option>
        {rest.map((c) => <option value={c.iso} selected={c.iso === country}>{c.name}</option>)}
      </Select>
    </div>

    {lookup && <button type="button" data-address-edit class="self-start bg-transparent border-0 p-0 font-display text-sm text-link hover:text-link-hover cursor-pointer"></button>}
  </fieldset>
</div>

<style>
  [data-address-fields] input[readonly] {
    background-color: var(--color-surface-tint);
    color: var(--color-text-muted);
    cursor: default;
  }
  [data-address-fields] select.locked {
    pointer-events: none;
    background-color: var(--color-surface-tint);
    color: var(--color-text-muted);
  }
</style>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-address]');
    if (!root) return;
    var lookup = root.getAttribute('data-lookup') === '1';
    if (!lookup) return;
    var hasAddress = root.getAttribute('data-has') === '1';
    var fields = root.querySelector('[data-address-fields]');
    var edit = root.querySelector('[data-address-edit]');
    var search = root.querySelector('[data-address-search]');
    var list = root.querySelector('[data-address-list]');
    var status = root.querySelector('[data-address-status]');
    var inputs = Array.prototype.slice.call(fields.querySelectorAll('input,select'));
    var session = '';
    var newSession = function () { session = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : ''; };
    newSession(); // one search session per address: Google bills the typing plus the pick as one
    var timer, abort, items = [], active = -1;

    // A dropdown can't be read-only, and CSS alone doesn't stop its label or the keyboard from changing it. While locked
    // it is truly disabled, and a hidden copy keeps its value in the form (disabled fields are not submitted).
    var mirrors = {};
    function lock(on) {
      inputs.forEach(function (i) {
        if (i.tagName === 'INPUT') { i.readOnly = on; return; }
        i.classList.toggle('locked', on);
        i.disabled = on;
        if (on) {
          var m = mirrors[i.name] || (mirrors[i.name] = document.createElement('input'));
          m.type = 'hidden'; m.name = i.name; m.value = i.value;
          if (!m.parentNode) i.parentNode.appendChild(m);
        } else if (mirrors[i.name] && mirrors[i.name].parentNode) {
          mirrors[i.name].parentNode.removeChild(mirrors[i.name]);
        }
      });
      edit.textContent = fields.hidden ? 'Or type the address in yourself' : 'Edit address manually';
      edit.hidden = !on && !fields.hidden;
    }
    function showFields() { fields.hidden = false; }
    lock(true);
    edit.addEventListener('click', function () { showFields(); lock(false); inputs[0].focus(); edit.hidden = true; });

    // The lookup costs money, so it answers only after a Turnstile check has been passed (a signed cookie, 30 minutes).
    var access = false, accessWait = null, retried = false;
    function loadTurnstile() {
      return new Promise(function (resolve, reject) {
        if (window.turnstile) return resolve();
        // The page may already be loading Turnstile for its own form: wait for that copy, never add a second one.
        if (document.querySelector('script[src*="turnstile/v0/api.js"]')) {
          var tries = 0;
          var wait = setInterval(function () {
            if (window.turnstile) { clearInterval(wait); resolve(); }
            else if (++tries > 80) { clearInterval(wait); reject(new Error('check')); }
          }, 125);
          return;
        }
        var s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        s.async = true; s.onload = function () { resolve(); }; s.onerror = reject;
        document.head.appendChild(s);
      });
    }
    function ensureAccess() {
      if (access) return Promise.resolve();
      if (accessWait) return accessWait;
      accessWait = loadTurnstile().then(function () {
        return new Promise(function (resolve, reject) {
          // The widget must live OUTSIDE the form: inside it, its token would be posted with the form (next to the page's own)
          // and the server would check the one that has already been used.
          var holder = document.createElement('div');
          holder.style.cssText = 'position:fixed;right:16px;bottom:16px;z-index:60';
          document.body.appendChild(holder);
          window.turnstile.render(holder, {
            sitekey: root.getAttribute('data-sitekey'),
            appearance: 'interaction-only',
            callback: function (token) {
              fetch('/api/address/session', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token: token }) })
                .then(function (r) { if (r.ok) { access = true; resolve(); } else reject(new Error('check')); })
                .catch(reject);
            },
            'error-callback': function () { reject(new Error('check')); },
          });
        });
      }).catch(function (e) { accessWait = null; throw e; });
      return accessWait;
    }
    function setStatus(msg) { status.textContent = msg || ''; }
    function close() { list.hidden = true; search.setAttribute('aria-expanded', 'false'); active = -1; }
    function render(previews) {
      items = previews; list.innerHTML = '';
      if (!previews.length) { var none = document.createElement('li'); none.className = 'px-4 py-2.5 text-sm text-text-muted'; none.textContent = 'No matches. You can type the address in yourself below.'; list.appendChild(none); }
      previews.forEach(function (p, idx) {
        var li = document.createElement('li'); li.setAttribute('role', 'option');
        var b = document.createElement('button'); b.type = 'button'; b.className = 'block w-full px-4 py-2.5 text-left bg-transparent border-0 cursor-pointer hover:bg-violet-50';
        var t = document.createElement('span'); t.className = 'block font-body text-sm text-text-body'; t.textContent = p.text;
        b.appendChild(t);
        if (p.description) { var d = document.createElement('span'); d.className = 'block font-body text-xs text-text-muted'; d.textContent = p.description + (p.type.toLowerCase() === 'address' ? '' : ' ›'); b.appendChild(d); }
        b.addEventListener('click', function () { pick(p); });
        li.appendChild(b); list.appendChild(li);
      });
      list.hidden = false; search.setAttribute('aria-expanded', 'true');
    }
    function highlight() {
      Array.prototype.forEach.call(list.querySelectorAll('button'), function (b, i) { b.classList.toggle('bg-violet-50', i === active); });
    }
    function fail(msg) { setStatus(msg); showFields(); lock(false); close(); }
    function query() {
      var q = search.value.trim();
      if (q.length < 3) { close(); setStatus(''); return; }
      if (abort) abort.abort(); abort = new AbortController();
      var params = new URLSearchParams(); params.set('q', q); if (session) params.set('session', session);
      setStatus('Searching…');
      ensureAccess().then(function () { return fetch('/api/address/complete?' + params.toString(), { signal: abort.signal }); }).then(function (r) { return r.json().then(function (b) { return { ok: r.ok, b: b }; }); })
        .then(function (x) {
          if (x.b && x.b.error === 'check') { access = false; accessWait = null; if (!retried) { retried = true; query(); return; } fail('We couldn’t complete the security check. Please type the address in.'); return; }
          retried = false;
          if (!x.ok) { fail(x.b.error || 'Address search isn’t working just now. Please type the address in.'); return; }
          setStatus(''); render(x.b.previews || []);
        })
        .catch(function (e) { if (e.name !== 'AbortError') fail('Address search isn’t working just now. Please type the address in.'); });
    }
    function pick(p) {
      setStatus('Getting the address…');
      ensureAccess().then(function () { return fetch('/api/address/complete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: p.id, session: session }) }); })
        .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, b: b }; }); })
        .then(function (x) {
          if (!x.ok || !x.b.address) { fail(x.b.error || 'Couldn’t get that address. Please type it in.'); return; }
          var a = x.b.address;
          var set = function (n, v) { var el = fields.querySelector('[name=' + n + ']'); if (el) el.value = v || ''; };
          set('street1', a.street1); set('street2', a.street2); set('city', a.city); set('state', a.state); set('zip', a.zip);
          var c = fields.querySelector('[name=country]');
          if (c && a.country) { if (!c.querySelector('option[value="' + a.country + '"]')) { var o = document.createElement('option'); o.value = a.country; o.textContent = a.country; c.appendChild(o); } c.value = a.country; }
          newSession(); search.value = ''; setStatus('Address filled in. Check it looks right.'); close(); showFields(); lock(true);
        })
        .catch(function () { fail('Couldn’t get that address. Please type it in.'); });
    }
    search.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(query, 250); });
    search.addEventListener('keydown', function (e) {
      var n = list.querySelectorAll('button').length;
      if (e.key === 'ArrowDown' && n) { e.preventDefault(); active = (active + 1) % n; highlight(); }
      else if (e.key === 'ArrowUp' && n) { e.preventDefault(); active = (active - 1 + n) % n; highlight(); }
      else if (e.key === 'Enter') { if (active >= 0 && items[active]) { e.preventDefault(); pick(items[active]); } else e.preventDefault(); }
      else if (e.key === 'Escape') close();
    });
    document.addEventListener('pointerdown', function (e) { if (!root.contains(e.target)) close(); });
    if (hasAddress) setStatus('');
  })();
</script>
