---
/**
 * Sends a form in the background and shows any error in place, so a failed attempt never wipes what the person typed.
 * Without JavaScript the form still posts normally and the server redirects back with the error. The page needs an
 * element with id "<formId>-error" for the message. See lib/form-response.ts for the server half.
 */
interface Props {
  formId: string;
}
const { formId } = Astro.props;
---

<script is:inline define:vars={{ formId }}>
  (function () {
    var form = document.getElementById(formId);
    var box = document.getElementById(formId + '-error');
    if (!form || !box || !window.fetch || !window.FormData) return;
    var button = form.querySelector('button[type=submit]');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      box.hidden = true;
      var label = button.textContent;
      button.disabled = true;
      button.textContent = 'Sending…';
      var fail = function (message) {
        box.textContent = message || 'Something went wrong. Please try again.';
        box.hidden = false;
        box.scrollIntoView({ block: 'center', behavior: 'smooth' });
        button.textContent = label;
        // A security token works once: ask the page's own widget for a fresh one (the button switches back on when it arrives).
        var widget = form.querySelector('.cf-turnstile');
        if (window.turnstile && widget) { try { window.turnstile.reset(widget); } catch (_) {} }
        setTimeout(function () { button.disabled = false; }, 6000);
      };
      fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json().catch(function () { return null; }).then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (x) {
          if (x.d && x.d.ok && x.d.redirect) { window.location.assign(x.d.redirect); return; }
          fail(x.d && x.d.message);
        })
        .catch(function () { fail('We couldn’t reach the website. Please check your connection and try again.'); });
    });
  })();
</script>
