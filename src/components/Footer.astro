---
const year = new Date().getFullYear();
---

<footer class="bg-gradient-dusk text-text-on-dark mt-24">
  <div
    class="container-site px-6 md:px-8 pt-14 pb-10 grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-10"
  >
    <div>
      <div
        class="font-display font-semibold text-[22px] tracking-[0.06em] mb-2.5"
      >
        Roseville New Church
      </div>
      <p class="m-0 text-[15px] text-text-on-dark/75 max-w-[340px]">
        A Swedenborgian community in Sydney — worshipping the Lord Jesus Christ
        and exploring His love and wisdom together.
      </p>
    </div>
    <div class="text-[15px] leading-[2]">
      <div
        class="font-display text-[12px] tracking-eyebrow uppercase text-gold-300 mb-2"
      >
        Visit
      </div>
      4 Shirley Rd, Roseville NSW 2069<br />
      Sundays at 10am
    </div>
    <div class="text-[15px] leading-[2]">
      <div
        class="font-display text-[12px] tracking-eyebrow uppercase text-gold-300 mb-2"
      >
        Contact
      </div>
      <a href="tel:+61294162812" class="text-violet-200 no-underline hover:text-gold-300"
        >+61 2 9416 2812</a
      ><br />
      <a
        href="mailto:info@rosevillenewchurch.com.au"
        class="text-violet-200 hover:text-gold-300">Email us</a
      >
    </div>
  </div>
  <div
    class="text-center pb-7 font-display text-[12px] tracking-[0.1em] text-text-on-dark/50"
  >
    © {year} Roseville New Church · ✦
  </div>
</footer>
