---
import Button from './Button.astro';

const year = new Date().getFullYear();
// The signup block is the footer's main call to action; hide it on the signup pages themselves.
const showSignup = !Astro.url.pathname.startsWith('/subscribe');
---

<footer class="bg-gradient-dusk text-text-on-dark mt-24">
  {
    showSignup && (
      <div class="border-b border-white/10">
        <div class="container-site px-6 md:px-8 py-10 md:py-12 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <div class="max-w-[620px]">
            <div class="font-display text-[12px] tracking-eyebrow uppercase text-gold-300 mb-2">
              Stay in touch
            </div>
            <div class="font-display font-semibold text-h2 tracking-display text-text-on-dark">
              Join the Roseville New Church mailing list
            </div>
            <p class="mt-2 mb-0 text-text-on-dark/80">
              News and notices from the church, and the Swedenborg Centre enews and Candela magazine if you’d like them. Free, and you can unsubscribe at any time.
            </p>
          </div>
          <Button
            variant="gold"
            size="lg"
            href="/subscribe"
            class="self-start md:self-auto shrink-0"
          >
            Join the mailing list
          </Button>
        </div>
      </div>
    )
  }
  <div
    class="container-site px-6 md:px-8 pt-14 pb-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] gap-10"
  >
    <div>
      <div
        class="font-display font-semibold text-[22px] tracking-[0.06em] mb-2.5"
      >
        Roseville New Church
      </div>
      <p class="m-0 text-[15px] text-text-on-dark/75 max-w-[340px]">
        The Sydney Society of The New Church — worshipping the Lord Jesus Christ
        and exploring His love and wisdom together.
      </p>
      <div class="flex gap-4 mt-5">
        <a
          href="https://www.facebook.com/RosevilleNewChurch"
          class="font-display text-[13px] tracking-[0.04em] text-violet-200 no-underline hover:text-gold-300"
          rel="noopener noreferrer"
          target="_blank"
        >
          Facebook
        </a>
        <a
          href="https://www.instagram.com/rosevillenewchurch/"
          class="font-display text-[13px] tracking-[0.04em] text-violet-200 no-underline hover:text-gold-300"
          rel="noopener noreferrer"
          target="_blank"
        >
          Instagram
        </a>
      </div>
    </div>
    <div class="text-[15px] leading-[2]">
      <div
        class="font-display text-[12px] tracking-eyebrow uppercase text-gold-300 mb-2"
      >
        Visit
      </div>
      2B Shirley Rd, Roseville NSW 2069<br />
      1st &amp; 3rd Sundays at 10am<br />
      <a
        href="/events"
        class="text-violet-200 no-underline hover:text-gold-300"
        >What's on →</a
      ><br />
      <a
        href="/give"
        class="text-violet-200 no-underline hover:text-gold-300"
        >Give to the church →</a
      >
    </div>
    <div class="text-[15px] leading-[2]">
      <div
        class="font-display text-[12px] tracking-eyebrow uppercase text-gold-300 mb-2"
      >
        Contact
      </div>
      <a
        href="/contact"
        class="text-violet-200 no-underline hover:text-gold-300"
        >Contact us</a
      ><br />
      <a
        href="tel:+61294167026"
        class="text-violet-200 no-underline hover:text-gold-300"
        >02 9416 7026</a
      ><br />
      <a
        href="mailto:admin@rosevillenewchurch.com.au"
        class="text-violet-200 no-underline hover:text-gold-300 break-all"
        >admin@rosevillenewchurch.com.au</a
      >
    </div>
    <div class="text-[15px] leading-[1.65]">
      <div
        class="font-display text-[12px] tracking-eyebrow uppercase text-gold-300 mb-2 leading-[2]"
      >
        Swedenborg Centre
      </div>
      <p class="m-0 text-text-on-dark/75">
        Online talks, discussion and study groups, and resources on Swedenborg's
        writings — an online service for Australia and beyond.
      </p>
      <a
        href="https://swedenborg.com.au/"
        class="inline-block mt-3 font-display font-semibold text-[14px] tracking-[0.03em] text-violet-200 no-underline hover:text-gold-300"
        rel="noopener noreferrer"
        target="_blank"
      >
        swedenborg.com.au →
      </a>
    </div>
  </div>
  <div
    class="text-center pb-7 font-display text-[12px] tracking-[0.1em] text-text-on-dark/50 px-6"
  >
    © {year} Roseville New Church · ✦ ·{' '}
    <a
      href="/privacy"
      class="text-text-on-dark/50 no-underline hover:text-gold-300"
      >Privacy</a
    >{' '}
    ·{' '}
    <a
      href="/login"
      class="text-text-on-dark/50 no-underline hover:text-gold-300"
      >Admin login</a
    >
  </div>
</footer>
