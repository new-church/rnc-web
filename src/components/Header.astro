---
import Button from './Button.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/events', label: 'Events' },
  // { href: '/blog', label: 'Blog' }, // hidden until the posts are finished (2026-11-13)
  { href: '/newsletters', label: 'Newsletters' },
];

// About is a drop-down. The Swedenborg Centre has a page here (so visitors aren't sent away) that links on to its own site.
const aboutLinks = [
  { href: '/about', label: 'About the church' },
  { href: '/about/membership', label: 'Membership and governance' },
  { href: '/about/swedenborg-centre', label: 'Swedenborg Centre' },
  { href: '/contact', label: 'Contact us' },
];
const aboutActive = currentPath === '/about' || currentPath.startsWith('/about/') || currentPath === '/contact';

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const linkBase =
  'font-display font-semibold tracking-[0.03em] no-underline rounded-pill transition-colors duration-150';
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-border-soft bg-paper/85 backdrop-blur-[12px]"
>
  <div
    class="container-site flex items-center gap-3 px-4 sm:px-6 md:px-8 py-2.5 md:py-3.5"
  >
    <a
      href="/"
      class="flex items-center gap-2 min-w-0 no-underline text-violet-900 hover:text-violet-900"
    >
      <img
        src="/brand/rnc-icon-colour.svg"
        alt=""
        width="40"
        height="28"
        class="h-7 md:h-8 w-auto shrink-0"
      />
      <span
        class="font-display font-semibold text-[15px] sm:text-[17px] md:text-[19px] tracking-[0.06em] truncate"
      >
        Roseville New Church
      </span>
    </a>

    <!-- Desktop nav -->
    <nav
      class="hidden lg:flex items-center gap-1 ml-auto"
      aria-label="Primary"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              linkBase,
              'text-[14px] px-2.5 xl:px-3.5 pt-2 pb-1.5',
              isActive(link.href)
                ? 'text-accent-primary-strong bg-violet-100'
                : 'text-text-muted hover:text-text-heading',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <div class="relative" id="about-menu">
        <button
          type="button"
          id="about-toggle"
          class:list={[
            linkBase,
            'inline-flex items-center gap-1 border-0 cursor-pointer text-[14px] px-2.5 xl:px-3.5 pt-2 pb-1.5',
            aboutActive
              ? 'text-accent-primary-strong bg-violet-100'
              : 'bg-transparent text-text-muted hover:text-text-heading',
          ]}
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="about-panel"
        >
          About
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
        </button>
        <div
          id="about-panel"
          role="menu"
          hidden
          class="absolute left-0 top-full mt-2 w-64 rounded-md border border-border-soft bg-white py-2 shadow-md z-50"
        >
          {
            aboutLinks.map((l) => (
              <a
                href={l.href}
                role="menuitem"
                aria-current={currentPath === l.href ? 'page' : undefined}
                class:list={[
                  'block px-4 py-2 font-display text-sm no-underline hover:bg-violet-50',
                  currentPath === l.href ? 'text-accent-primary-strong font-semibold' : 'text-text-heading',
                ]}>{l.label}</a>
            ))
          }
        </div>
      </div>
      <Button variant="secondary" size="sm" href="/login" id="login-link" class="ml-2">
        Log in
      </Button>
      <Button variant="gold" size="sm" href="/subscribe" id="signup-link" class="ml-1">
        Sign up
      </Button>
    </nav>

    <!-- Mobile / tablet: compact CTA + menu toggle -->
    <div class="flex items-center gap-1.5 ml-auto lg:hidden">
      <Button
        variant="gold"
        size="sm"
        href="/subscribe"
        id="signup-link-compact"
        class="!px-3 !pt-2 !pb-1.5 !text-[12px]"
      >
        Sign up
      </Button>
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex items-center justify-center size-10 rounded-pill text-violet-900 hover:bg-violet-100 transition-colors duration-150"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg
          id="nav-icon-open"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          id="nav-icon-close"
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <!-- Account menu: hidden for everyone until they have signed in (see the script below) -->
    <div id="account-menu" class="relative" hidden>
      <button
        type="button"
        id="account-toggle"
        class="inline-flex items-center justify-center size-10 rounded-pill text-violet-900 hover:bg-violet-100 transition-colors duration-150"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="account-panel"
        aria-label="Your account"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4 20c0-3.6 3.6-6 8-6s8 2.4 8 6"></path>
        </svg>
      </button>
      <div
        id="account-panel"
        role="menu"
        hidden
        class="absolute right-0 top-full mt-2 w-60 rounded-md border border-border-soft bg-white py-2 shadow-md z-50"
      >
        <p id="account-email" class="m-0 px-4 pb-2 mb-1 text-xs text-text-muted truncate border-b border-border-soft"></p>
        <a id="account-link-member" href="/account/details" role="menuitem" hidden class="block px-4 py-2 font-display text-sm text-text-heading no-underline hover:bg-violet-50">Your account</a>
        <a id="account-link-admin" href="/admin/actions" role="menuitem" hidden class="block px-4 py-2 font-display text-sm text-text-heading no-underline hover:bg-violet-50">Admin</a>
        <form method="post" action="/api/auth/logout" class="m-0">
          <button type="submit" role="menuitem" class="block w-full text-left px-4 py-2 font-display text-sm text-text-heading bg-transparent border-0 cursor-pointer hover:bg-violet-50">Sign out</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <nav
    id="mobile-nav"
    class="lg:hidden hidden border-t border-border-soft bg-paper/95 backdrop-blur-[12px]"
    aria-label="Mobile"
    hidden
  >
    <div class="container-site px-4 sm:px-6 py-3 flex flex-col gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              linkBase,
              'text-[16px] px-4 py-3',
              isActive(link.href)
                ? 'text-accent-primary-strong bg-violet-100'
                : 'text-text-muted hover:text-text-heading hover:bg-violet-50',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <div
        class:list={[
          linkBase,
          'text-[16px] px-4 pt-3 pb-1',
          aboutActive ? 'text-accent-primary-strong' : 'text-text-heading',
        ]}
      >
        About
      </div>
      {
        aboutLinks.map((l) => (
          <a
            href={l.href}
            class:list={[
              linkBase,
              'text-[16px] pl-8 pr-4 py-2.5',
              currentPath === l.href
                ? 'text-accent-primary-strong bg-violet-100'
                : 'text-text-muted hover:text-text-heading hover:bg-violet-50',
            ]}
            aria-current={currentPath === l.href ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <div class="pt-2 pb-1 px-1 flex flex-col gap-2">
        <Button variant="secondary" size="md" href="/login" id="login-link-mobile" class="w-full">
          Log in
        </Button>
        <Button variant="gold" size="md" href="/subscribe" id="signup-link-mobile" class="w-full">
          Sign up
        </Button>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.classList.toggle('hidden', !open);
    panel.hidden = !open;
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.classList.toggle('overflow-hidden', open);
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!open);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  const mq = window.matchMedia('(min-width: 1024px)');
  mq.addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });

  // About drop-down: click or tap to open, Escape or a click elsewhere to close.
  (function () {
    const wrap = document.getElementById('about-menu');
    const toggle = document.getElementById('about-toggle');
    const panel = document.getElementById('about-panel');
    if (!wrap || !toggle || !panel) return;
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('pointerdown', (e) => {
      if (!wrap.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    panel.addEventListener('focusout', (e) => {
      if (!wrap.contains((e as FocusEvent).relatedTarget as Node)) setOpen(false);
    });
  })();

  // The Log in and Sign up buttons give way to the account menu once someone is signed in (the marker cookie only says "a session
  // may exist"; the account menu script below confirms it and puts them back if it has ended).
  (function () {
    const login = ['login-link', 'login-link-mobile', 'signup-link', 'signup-link-compact', 'signup-link-mobile'].map((id) => document.getElementById(id));
    if (document.cookie.split('; ').includes('rnc_in=1')) login.forEach((el) => el && (el.hidden = true));
    window.addEventListener('rnc:signed-out', () => login.forEach((el) => el && (el.hidden = false)));
  })();

  // Account menu. A plain "signed in" cookie (no personal details) is set when someone signs in; only then do we ask the
  // server who they are. Visitors who never signed in see nothing and make no extra request.
  (function () {
    const wrap = document.getElementById('account-menu');
    if (!wrap || !document.cookie.split('; ').includes('rnc_in=1')) return;
    const toggle = document.getElementById('account-toggle');
    const panel = document.getElementById('account-panel');
    const closeMenu = () => {
      if (!toggle || !panel) return;
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };
    fetch('/api/account/whoami', { credentials: 'same-origin', cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then((w) => {
        if (!w || (!w.member && !w.admin)) {
          // The server session has ended: forget the marker so we stop asking.
          document.cookie = 'rnc_in=; Max-Age=0; path=/';
          window.dispatchEvent(new Event('rnc:signed-out'));
          return;
        }
        const email = document.getElementById('account-email');
        if (email) email.textContent = w.email || '';
        const member = document.getElementById('account-link-member');
        const admin = document.getElementById('account-link-admin');
        if (member) member.hidden = !w.member;
        if (admin) admin.hidden = !w.admin;
        wrap.hidden = false;
      })
      .catch(() => {});
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      if (panel) panel.hidden = open;
      toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
    document.addEventListener('pointerdown', (e) => {
      if (!wrap.contains(e.target as Node)) closeMenu();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
  })();
</script>
