---
import Button from './Button.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/events', label: 'Events' },
  { href: '/about', label: 'About' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  class="sticky top-0 z-40 border-b border-border-soft bg-paper/85 backdrop-blur-[12px]"
>
  <div
    class="container-site flex flex-wrap items-center gap-4 px-6 md:px-8 py-3.5"
  >
    <a
      href="/"
      class="font-display font-semibold text-[19px] tracking-[0.06em] text-violet-900 no-underline whitespace-nowrap hover:text-violet-900"
    >
      Roseville New Church
    </a>
    <nav
      class="flex flex-wrap items-center gap-1.5 ml-auto"
      aria-label="Primary"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'font-display font-semibold text-[15px] tracking-[0.03em] no-underline px-3.5 pt-2 pb-1.5 rounded-pill transition-colors duration-150',
              isActive(link.href)
                ? 'text-accent-primary-strong bg-violet-100'
                : 'text-text-muted hover:text-text-heading',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://swedenborg.com.au/"
        class="font-display font-semibold text-[15px] tracking-[0.03em] no-underline px-3.5 pt-2 pb-1.5 rounded-pill text-text-muted hover:text-text-heading transition-colors duration-150"
        rel="noopener noreferrer"
        target="_blank"
      >
        Swedenborg Centre
      </a>
      <Button variant="gold" size="sm" href="/about#visit" class="ml-2.5">
        Plan a visit
      </Button>
    </nav>
  </div>
</header>
